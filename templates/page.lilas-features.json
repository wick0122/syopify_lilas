    "s04": {
      "type": "lx-features-04",
      "settings": {
        "t_1": "01",
        "t_2": "こんな方に",
        "t_3": "自分に合うスキンケアが、わからない",
        "t_4": "乾燥が気になる",
        "t_5": "うるおいとツヤのある肌を目指したい",
        "t_6": "何本も重ねるお手入れが、面倒",
        "t_7": "今使っている化粧品に、満足していない",
        "t_8": "敏感な肌のことを考えた保湿を探している",
        "t_9": "スキンケアの費用を抑えたい",
        "t_10": "家族やパートナーと一緒に使いたい"
      }
    },
    "s05": {
      "type": "lx-features-05",
      "settings": {
        "t_1": "02",
        "t_2": "調節できる、という\n新しいオールインワン",
        "t_3": "年齢や季節によって、肌の水分や油分のバランスは変わっていきます。肌が変わるたびに化粧品を探し直すのではなく、ブレンドオイルを加える量で、今の肌に合わせて調える。それがLilasの考え方です。",
        "t_4": "i.",
        "t_5": "朝と夜で",
        "t_6": "朝は軽やかに、夜はオイルを加えた1本でしっとりと。",
        "t_7": "ii.",
        "t_8": "季節で",
        "t_9": "夏は軽やかに、乾く冬はオイルを多めに。季節に合わせて調えて。",
        "t_10": "iii.",
        "t_11": "ふたりで",
        "t_12": "自分用と、パートナー用に。それぞれ好みの仕上がりで1本ずつ。",
        "t_13": "iv.",
        "t_14": "重ねづけで",
        "t_15": "乾燥や美容面で重点的にケアしたい部分には、丁寧に重ねづけを。",
        "t_16": "1本をじっくり使うのも、朝と夜、季節や使う人に合わせ、<br/><b>何本かを使い分ける</b>のも自由です。",
        "t_17": "製品を見る"
      }
    },
    "s06": {
      "type": "lx-features-06",
      "settings": {
        "t_1": "03",
        "t_2": "手間を省きながら、1本で5役",
        "t_3": "化粧水",
        "t_4": "美容液",
        "t_5": "乳液",
        "t_6": "パック<small>3倍ほどに薄めて</small>",
        "t_7": "ハンドケア",
        "t_8": "化粧水から、美容液、乳液、パックまで。いくつものアイテムを重ねなくとも、1本でお手入れが完結します。乾燥しがちな目元・口元を、うるおいで満たし、なめらかな肌へ。首すじや手のお手入れにも。1本で約4ヶ月、毎日のお手入れに長く寄り添います。"
      }
    },
    "s07": {
      "type": "lx-features-07",
      "settings": {
        "t_1": "Moisture",
        "t_2": "04",
        "t_3": "Lilasが考える、",
        "t_4": "保湿のかたち",
        "t_5": "保湿とは、「保水」「水分保持」「保護」の3つのバランスを整え、補うこと。",
        "t_6": "Hold",
        "t_7": "保水",
        "t_8": "保湿成分が、水分を抱え込む。",
        "t_9": "Keep",
        "t_10": "水分保持",
        "t_11": "抱えた水分を、逃しにくくする。",
        "t_12": "Protect",
        "t_13": "保護",
        "t_14": "植物ブレンドオイルが覆い、皮膚を保護する。",
        "t_15": "<b>水分と油分の割合</b>健康なお肌の水分と油分バランス8:2にならい、濃縮ローションには水分と油分2層の処方を採用。",
        "t_16": "※保湿:皮膚にうるおいを与え、乾燥を防ぐこと。\n3つの要素は、保湿成分と植物ブレンドオイルの働きを表しています。"
      }
    },
    "s08": {
      "type": "lx-features-08",
      "settings": {
        "t_1": "i — <em>Layer</em>",
        "t_2": "保湿成分は、1枚の「網」",
        "t_3": "保湿成分の一つひとつを、1枚の「網」と思い描いてみてください。",
        "t_4": "1枚だけでは、網目の隙間から水分が逃げやすいもの。性質の異なる保湿成分を何種も配合することで、網目は細かく重なり、うるおいを逃しにくくなります。",
        "t_5": "<b>とろみ</b>増粘剤を使わず、重ねた保湿成分そのものが生む、濃厚なとろみ。"
      }
    },
    "s09": {
      "type": "lx-features-09",
      "settings": {
        "t_1": "ii — <em>Concentrate</em>",
        "t_2": "網そのものを、大きく広げる",
        "t_3": "網目を細かくしても、網そのものが小さければ、覆える範囲は限られます。",
        "t_4": "Lilasが保湿成分を高濃度に配合するのは、この網を大きく広げるためです。増粘剤なしの天然保水成分の贅沢なとろみ。1gで6Lの水分を抱え込む高分子ヒアルロン酸Naに、低分子ヒアルロン酸Na、シロキクラゲ多糖体を合わせた濃縮保湿設計が共通の土台です。",
        "t_5": "<i style=\"background:#a9bcc2\"></i>和漢植物エキス&保湿成分<b>92%以上</b>",
        "t_6": "<i style=\"background:#e8eeef\"></i>エキスにもともと含まれる水<b>8%以下</b>",
        "t_7": "92%以上の内訳:保湿成分・水分保持成分・和漢植物エキス・植物オイル成分<em class=\"tbc\">要確認</em>",
        "t_8": "<b>色</b>着色料を使わず、和漢植物エキスそのものの琥珀色。",
        "t_9": "※新たに加えた水は0%。"
      }
    },
    "s10": {
      "type": "lx-features-10",
      "settings": {
        "t_1": "iii — <em>Protect</em>",
        "t_2": "重ねた網を、ブレンドオイルで包む",
        "t_3": "最後に、リラ考案のオリジナルブレンドオイルが、網の上からやさしく覆い、うるおいを抱えたまま皮膚を保護します。",
        "t_4": "使う直前に振り合わせる2層式は、この3つを1本で叶えるための設計です。",
        "t_5": "オイルの量で、今の肌に合わせて調節する<span aria-hidden=\"true\">→</span>"
      }
    },
    "s11": {
      "type": "lx-features-11",
      "settings": {
        "t_1": "Ritual",
        "t_2": "だから1プッシュずつ、",
        "t_3": "なじむのを待って、",
        "t_4": "数回重ねる。",
        "t_5": "うるおいの網を、ミルフィーユのように一枚ずつ。\nそれが、Lilasのおすすめする使い方です。",
        "t_6": "特別なうるおいを、毎日に。",
        "t_7": "Moisture, for every day."
      }
    },
    "s12": {
      "type": "lx-features-12",
      "settings": {
        "t_1": "Craft & Care",
        "t_2": "Made <em>with care</em>",
        "t_3": "入れないもの、手をかけること",
        "t_4": "配合していない、10の成分",
        "t_5": "乳化剤<small>合成界面活性剤</small>",
        "t_6": "シリコン",
        "t_7": "合成香料",
        "t_8": "合成着色料",
        "t_9": "タール系色素",
        "t_10": "石油由来\nミネラル油",
        "t_11": "石油由来\nワセリン",
        "t_12": "エデト酸塩",
        "t_13": "安息香酸",
        "t_14": "PG<small>プロピレングリコール</small>",
        "t_15": "長期保存のための添加物に頼らず、使用期限を短めに設定。<br/><b>未開封で2年、開封後は6ヶ月</b>を目安にお使いください。",
        "t_16": "※すべての方に肌トラブルが起こらないということではありません。",
        "t_17": "Small Batch, Made in Japan",
        "t_18": "国内工場で100本ずつ、大切に製造",
        "t_19": "仕上げのブレンドオイルも一つひとつ手作業で加える、こだわりの2層式。手間を惜しまない2工程を経て、国内工場で100本ずつの小ロットで丁寧に仕上げています。",
        "t_20": "4 months",
        "t_21": "1本で、約4ヶ月のお手入れを",
        "t_22": "肌の状態に合わせて、必要な部分に必要なだけ、うるおいを重ねる。\n毎日のスキンケアに、約4ヶ月間じっくりと寄り添う1本です。"
      }
    },
    "s13": {
      "type": "lx-features-13",
      "settings": {
        "t_1": "Your <em>way</em>",
        "t_2": "肌に合わせて、使い方も自由に。",
        "t_3": "1本でも、オールインワンとして使えるLilas。\nさらに保湿感を高めたいときは、ブレンドオイルで調節できます。",
        "t_4": "製品を見る"
      }
    },
    "s14": {
      "type": "lx-features-14",
      "settings": {
        "t_1": "07",
        "t_2": "From the <em>founder</em>",
        "t_3": "肌に自信が持てると、表情が、晴れていく。",
        "t_4": "エステ＆アロマサロンと調合スキンケア教室を10年営むなかで、たくさんの肌にふれてきました。体が健やかでも、肌に自信が持てないと、心はなかなか上を向かない。そのことを、何度も目の当たりにしてきました。",
        "t_5": "ブランドの歩みを読む<i>→</i>",
        "t_6": "開発者自身も、12年以上使い続けています。",
        "t_7": "Lilas 開発者<span>Hano Miyu</span>"
      }
    }
