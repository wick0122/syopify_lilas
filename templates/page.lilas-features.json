    "point-1": {
      "type": "lilas-feature-point",
      "settings": {
        "anchor": "adjust",
        "folio": "Point 01",
        "word": "Adjust",
        "heading": "季節、年齢、性別、肌質に合わせて\n調えられる、オールインワン。",
        "text": "<p>年齢とともに、肌の水分や皮脂のバランスは少しずつ変わっていきます。肌が変わるたびに化粧品を探し直すのではなく、<strong>今の肌に合わせて調える</strong>という考え方。</p><p>濃縮ローションに、ブレンドオイルを必要な分だけ加えて。季節や乾き具合に合わせて、自分にちょうどいい1本に仕上げます。</p>",
        "fallback": "lilas-moisture-wide.jpg",
        "image_alt": "濃縮ローションにブレンドオイルを加える手元",
        "arch": false,
        "reverse": false,
        "tint": true,
        "style": "list",
        "link_label": "Blend oil",
        "link_sub": "ブレンドオイルを見る",
        "note": "※オイルを加える量の目安：やや乾燥が気になる方は半量〜3分の2、乾燥が強い方は全量。"
      },
      "blocks": {
        "p1-1": {
          "type": "item",
          "settings": {
            "title": "5種のオイル",
            "text": "アンズ核油・スクワラン・セサミ油・ヒマシ油・シア脂"
          }
        },
        "p1-2": {
          "type": "item",
          "settings": {
            "title": "乾燥を防ぐ",
            "text": "油分が肌を守り、うるおいを保ちます"
