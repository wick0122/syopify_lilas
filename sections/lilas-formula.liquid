{{ 'lilas-formula.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lilas-formula.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  肌診断。
  診断の質問と結果の組み立ては assets/lilas-formula.js。
  ここで Shopify の商品を選ぶと、結果の価格と「カートに入れる」が本物の商品になります。
{%- endcomment -%}

{%- assign keys = 'aging,bright,smooth,sensitive,oil,serum,balm' | split: ',' -%}

<section class="fml" id="{{ section.settings.anchor | default: 'formula' }}" data-lilas-formula>
  <div class="fm-top" data-r>
    <span class="qlbl">{{ section.settings.label }}</span>
    <p class="disp">{{ section.settings.display }}</p>
    <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
  </div>

  <div class="fm-mid">
    <div class="fm-in">
      <div class="fm-txt" data-r>
        <h3>{{ section.settings.sub_heading }}</h3>
        <p>{{ section.settings.sub_text }}</p>
      </div>
      <figure class="fm-ph" data-r>
        <div class="ph arch dewph">
          {%- render 'lilas-image', image: section.settings.image, fallback: 'lilas-formula.jpg', alt: 'ローションのしずく' -%}
          <span class="ripple dk"><i></i><i></i><i></i></span>
        </div>
      </figure>
    </div>
  </div>

  <div class="fm-bot">
    <div class="qopts" data-r>
      <button type="button" data-v="dry" class="main">{{ section.settings.opt_dry }}</button>
      <button type="button" data-v="aging">{{ section.settings.opt_aging }}</button>
      <button type="button" data-v="smooth">{{ section.settings.opt_smooth }}</button>
      <button type="button" data-v="bright">{{ section.settings.opt_bright }}</button>
    </div>
  </div>

  <dialog class="lilas-dlg" aria-label="肌診断">
    <div class="dlg">
      <button class="x" type="button" data-close>閉じる</button>
      <div data-body></div>
    </div>
  </dialog>

  {%- comment -%} 管理画面で選んだ商品の情報を、JS に渡す {%- endcomment -%}
  <script type="application/json" data-formula-data>
    {
      "freeShipping": {{ section.settings.free_shipping | default: 0 }},
      "products": {
        {%- for key in keys -%}
          {%- assign setting_id = 'product_' | append: key -%}
          {%- assign p = section.settings[setting_id] -%}
          {{ key | json }}: {%- if p != blank -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            { "n": {{ p.title | json }}, "p": {{ v.price | money_without_currency | remove: ',' | remove: '.00' | json }}, "variant": {{ v.id }} }
          {%- else -%}
            null
          {%- endif -%}
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    }
  </script>
</section>

{% schema %}
{
  "name": "Lilas 肌診断",
  "settings": [
    { "type": "text", "id": "anchor", "label": "ID（目次からの移動先）", "default": "formula" },
    { "type": "text", "id": "label", "label": "ラベル", "default": "04 ・ Your formula" },
    { "type": "text", "id": "display", "label": "大きな英字", "default": "Your <em>Formula</em>", "info": "<em>〜</em> で囲むと斜体になります" },
    { "type": "textarea", "id": "heading", "label": "見出し", "default": "いま、いちばん\n気になることは。" },
    { "type": "text", "id": "sub_heading", "label": "小見出し", "default": "あなたの処方を見つける" },
    { "type": "text", "id": "sub_text", "label": "説明", "default": "三つの質問に答えるだけで、今の肌に合う組み合わせをご提案します。" },
    { "type": "image_picker", "id": "image", "label": "写真（上が丸い形）" },
    { "type": "header", "content": "最初の質問の選択肢" },
    { "type": "text", "id": "opt_dry", "label": "乾燥", "default": "乾燥" },
    { "type": "text", "id": "opt_aging", "label": "ハリ", "default": "ハリ" },
    { "type": "text", "id": "opt_smooth", "label": "テカリ・キメ", "default": "テカリ・キメ" },
    { "type": "text", "id": "opt_bright", "label": "ツヤ・くすみ", "default": "ツヤ・くすみ" },
    { "type": "header", "content": "結果に出す商品" },
    { "type": "paragraph", "content": "商品を選ぶと、結果の価格と「この組み合わせをカートに入れる」が本物の商品になります。未設定のときは仮の名前と価格を表示します。" },
    { "type": "product", "id": "product_aging", "label": "エイジングケア" },
    { "type": "product", "id": "product_bright", "label": "ブライトアップ" },
    { "type": "product", "id": "product_smooth", "label": "スムーススキン" },
    { "type": "product", "id": "product_sensitive", "label": "センシティブケア" },
    { "type": "product", "id": "product_oil", "label": "ブレンドオイル" },
    { "type": "product", "id": "product_serum", "label": "モイストヴェールセラム" },
    { "type": "product", "id": "product_balm", "label": "マルチバーム" },
    { "type": "number", "id": "free_shipping", "label": "送料無料になる金額（円）", "default": 14000 }
  ],
  "presets": [{ "name": "Lilas 肌診断" }]
}
{% endschema %}
