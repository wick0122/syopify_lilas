<ul class="chips"><li>{{ section.settings.t_8 | escape }}</li><li>{{ section.settings.t_9 | escape }}</li><li>{{ section.settings.t_10 | escape }}</li><li>{{ section.settings.t_11 | escape }}</li><li>{{ section.settings.t_12 | escape }}</li></ul>
<p class="ag-note">{{ section.settings.t_13 | escape }}</p>
<div class="price"><b>{{ section.settings.t_14 | escape }}</b><small>{{ section.settings.t_15 | escape }}</small><span class="vol" id="szVol">{{ section.settings.t_16 | escape }}</span></div><p class="saleonly">{{ section.settings.t_17 | escape }}</p><div aria-label="容量" class="szsel" role="group"><button class="on" data-g="お顔まわりで約1ヶ月分" data-i="2" data-note="今回のロット使用期限：2026年12月末" data-p="5060" data-s="60ml ・ 今だけ2本セット" type="button">{{ section.settings.t_18 | escape }}</button><button class="is-sold" disabled aria-disabled="true" data-g="全身で約3ヶ月分" data-i="1" data-note="完売しました" data-p="9020" data-s="200ml ・ 今だけ2本セット" type="button">{{ section.settings.t_19 | escape }}<small class="sold-tag">完売</small></button></div><p class="szguide" id="szGuide"><b>{{ section.settings.t_20 | escape }}</b><span>{{ section.settings.t_21 | escape }}</span><span>{{ section.settings.t_22 | escape }}</span></p>
<div aria-label="オプション" class="opt-box" role="group"><label class="opt"><input data-price="330" id="optGift" type="checkbox"/><img alt="" class="ti" decoding="async" loading="lazy" src="{% if section.settings.img_6 %}{{ section.settings.img_6 | image_url: width: 1800 }}{% else %}{{ 'img-3bdc8772dbe5.webp' | asset_url }}{% endif %}"/><span><b>{{ section.settings.t_23 | escape }}</b><small>{{ section.settings.t_24 | escape }}</small></span><span class="p">{{ section.settings.t_25 | escape }}</span></label></div>
<div class="qtyrow">
