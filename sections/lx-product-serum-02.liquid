{%- liquid
  assign p = section.settings.product
  assign po = section.settings.oil_product
  assign pg = section.settings.gift_product
-%}
{%- if p -%}
<script>
window.LX_PRICE={{ p.selected_or_first_available_variant.price | divided_by: 100 }};
window.LX_CART={
  variants:[{%- for v in p.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"available":{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  oil:{% if po %}{{ po.selected_or_first_available_variant.id }}{% else %}null{% endif %},
  gift:{% if pg %}{{ pg.selected_or_first_available_variant.id }}{% else %}null{% endif %}
};
</script>
{%- endif -%}
<section class="wrap buy lx-top lx-n1" id="buy">
<div class="gal">
<div aria-label="製品写真" class="thumbs" role="tablist"><button aria-label="写真1" class="on" data-src="{% if section.settings.img_5 %}{{ section.settings.img_5 | image_url: width: 1800 }}{% else %}{{ 'img-ef66aa728c5f.webp' | asset_url }}{% endif %}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_1 %}{{ section.settings.img_1 | image_url: width: 1800 }}{% else %}{{ 'img-83482eafc361.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真2" data-src="{{ 'img-68b062fc68b6.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_2 %}{{ section.settings.img_2 | image_url: width: 1800 }}{% else %}{{ 'img-6cc46e8a4257.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真3" data-src="{{ 'img-db4db86b97f5.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_3 %}{{ section.settings.img_3 | image_url: width: 1800 }}{% else %}{{ 'img-ec9080f1737f.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真4" data-src="{{ 'img-5b69fc28c92a.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_4 %}{{ section.settings.img_4 | image_url: width: 1800 }}{% else %}{{ 'img-e4c12576a82e.webp' | asset_url }}{% endif %}"/></button></div>
<figure class="ph main-ph"><img alt="モイストヴェールセラム" decoding="async" id="mainImg" loading="lazy" src="{% if section.settings.img_5 %}{{ section.settings.img_5 | image_url: width: 1800 }}{% else %}{{ 'img-ef66aa728c5f.webp' | asset_url }}{% endif %}"/><span class="stamps"><span class="salebdg">{{ section.settings.t_1 | escape }}</span><span class="vg-badge"><svg aria-hidden="true" viewbox="0 0 16 16"><path d="M3 13C3 6 8 3 14 3C14 9 10 13 3 13Z M3 13L9 7" fill="none" stroke="currentColor" stroke-width="1"></path></svg>{{ section.settings.t_2 | escape }}</span></span></figure>
</div>
<div class="info">
<span class="nmb">{{ section.settings.t_3 | escape }}</span>
<h1>{{ section.settings.t_4 }}</h1>
<p class="jp">{{ section.settings.t_5 | escape }}</p><p class="subt">{{ section.settings.t_6 | escape }}</p>
