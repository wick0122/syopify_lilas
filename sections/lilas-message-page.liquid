      "type": "text",
      "id": "message_url",
      "label": "「Lilasの想い」のリンク先",
      "default": "/pages/message"
    },
    {
      "type": "text",
      "id": "about_url",
      "label": "「ブランドの歩み」のリンク先",
      "default": "/pages/about"
    },
    {
      "type": "text",
      "id": "partner_url",
      "label": "「販売パートナー」のリンク先",
