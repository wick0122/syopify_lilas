<div class="np">
<section class="np-sec np-add">
<div class="wrap">
<div class="np-hd" data-r=""><span class="qlbl">{{ section.settings.t_1 | escape }}</span><p class="disp">{{ section.settings.t_2 }}</p><h2 class="sh2">{{ section.settings.t_3 | escape }}</h2></div>
<div class="np-add-in">
<div class="np-duo" data-r="">
<div class="np-du base"><span class="tag">{{ section.settings.t_4 | escape }}</span><p class="nm">{{ section.settings.t_5 | escape }}</p><p class="ds">{{ section.settings.t_6 | escape }}</p></div>
<span aria-hidden="true" class="np-plus">{{ section.settings.t_7 | escape }}</span>
<div class="np-du"><span class="tag">{{ section.settings.t_8 | escape }}</span><p class="nm">{{ section.settings.t_9 | escape }}</p><p class="ds">{{ section.settings.t_10 | escape }}</p></div>
</div>
<figure class="np-arch" data-r=""><img alt="3種の濃縮ローションとブレンドオイル" decoding="async" loading="lazy" src="{% if section.settings.img_1 %}{{ section.settings.img_1 | image_url: width: 1800 }}{% else %}{{ 'img-29fdcc6b52fe.webp' | asset_url }}{% endif %}"/></figure>
</div>
</div>
</section>
<section class="np-sec np-alt np-how" id="oil-check">
<div class="wrap">
<div class="np-hd" data-r=""><p class="disp">{{ section.settings.t_11 }}</p><h2 class="sh2">{{ section.settings.t_12 | escape }}</h2><p class="np-band">{{ section.settings.t_13 | escape }}</p></div>
<div class="np-how-in">
<div class="np-how-l"><figure class="np-ph" data-r=""><img alt="ローションにブレンドオイルを加える手元" decoding="async" loading="lazy" src="{% if section.settings.img_2 %}{{ section.settings.img_2 | image_url: width: 1800 }}{% else %}{{ 'img-ce2152ba1fcc.webp' | asset_url }}{% endif %}"/></figure><div class="np-how-tx"><h3>{{ section.settings.t_14 | escape }}</h3><ol><li>{{ section.settings.t_15 | escape }}</li><li>{{ section.settings.t_16 | escape }}</li><li>{{ section.settings.t_17 | escape }}</li></ol></div></div>
<div class="oc" data-line="std" data-r="">
<p class="oc-q">{{ section.settings.t_18 | escape }}</p>
<div class="oc-step oc-s1"><span class="oc-stepn">{{ section.settings.t_19 | escape }}</span><p class="oc-sub"><b>{{ section.settings.t_20 | escape }}</b></p>
<div aria-label="肌タイプ" class="oc-opts oc-types" role="radiogroup">
<button aria-checked="false" data-k="mochi" role="radio" type="button">{{ section.settings.t_21 | escape }}</button>
<button aria-checked="false" data-k="sara" role="radio" type="button">{{ section.settings.t_22 | escape }}</button>
<button aria-checked="false" data-k="kona" role="radio" type="button">{{ section.settings.t_23 | escape }}</button>
<button aria-checked="false" data-k="teka" role="radio" type="button">{{ section.settings.t_24 | escape }}</button>
<button aria-checked="false" data-k="mix" role="radio" type="button">{{ section.settings.t_25 | escape }}</button>
<button aria-checked="false" data-k="sens" role="radio" type="button">{{ section.settings.t_26 | escape }}</button>
</div>
<div class="oc-help"><a class="oc-tocheck" href="/pages/lilas-products#formula">{{ section.settings.t_27 }}</a>
</div>
</div>
<dialog aria-label="分量診断" class="oc-dlg" id="ocDlg"><button aria-label="閉じる" class="oc-dlg-x" type="button">{{ section.settings.t_28 | escape }}</button><div class="oc-step2 oc-step oc-s2"><span class="oc-stepn">{{ section.settings.t_29 | escape }}</span><p class="oc-sub oc-sub2"><b>{{ section.settings.t_30 | escape }}</b></p>
<div aria-label="過ごし方" class="oc-opts oc-env" role="group">
<button aria-pressed="false" data-e="dry" type="button">{{ section.settings.t_31 | escape }}</button>
<button aria-pressed="false" data-e="uv" type="button">{{ section.settings.t_32 | escape }}</button>
<button aria-pressed="false" data-e="sweat" type="button">{{ section.settings.t_33 | escape }}</button>
<button aria-pressed="false" data-e="nose" type="button">{{ section.settings.t_34 | escape }}</button>
<span aria-hidden="true" class="oc-br"></span><button aria-pressed="false" data-e="none" type="button">{{ section.settings.t_35 | escape }}</button>
</div>
<button class="oc-go" disabled="" type="button">{{ section.settings.t_36 | escape }}</button><div class="oc-nav"><button class="oc-back oc-b-back" data-to="1" type="button">{{ section.settings.t_37 }}</button></div></div>
<div class="oc-step oc-s3"><span class="oc-stepn">{{ section.settings.t_38 | escape }}</span>
<div aria-live="polite" class="oc-res oc-res2">
<p class="oc-type" id="ocType"></p>
<div class="oc-wb"><div class="oc-wbtop"><div class="oc-tri" id="ocTri"></div><div class="oc-chips" id="ocChips"></div></div><div class="oc-amtbox"><p class="oc-per2">{{ section.settings.t_39 | escape }}</p><p class="oc-amt" id="ocAmt"></p><div aria-hidden="true" class="oc-gauge"><div class="oc-track"><i id="ocRange"></i></div><div class="oc-ticks"><span>{{ section.settings.t_40 | escape }}</span><span>{{ section.settings.t_41 | escape }}</span><span>{{ section.settings.t_42 | escape }}</span><span>{{ section.settings.t_43 | escape }}</span><span>{{ section.settings.t_44 | escape }}</span></div></div></div><p class="oc-envline" id="ocEnvLine"></p><p class="oc-tx oc-tx-in" id="ocTx"></p></div>
<div class="oc-more"><ol class="oc-steps" id="ocSteps"></ol><div class="oc-envnotes" id="ocEnv"></div></div>
</div>
<p class="oc-envfine oc-fine-w" id="ocFine"></p>
<div class="oc-nav"><button class="oc-back oc-b-back" data-to="2" type="button">{{ section.settings.t_45 }}</button><button class="oc-back oc-b-restart" data-to="0" type="button">{{ section.settings.t_46 }}</button></div></div></dialog>
</div>
</div>
</div>
<div class="feat-more-wrap"><a class="feat-more" href="/pages/lilas-features">{{ section.settings.t_47 }}</a></div>
</section>
<section class="np-sec np-alt np-way" id="yourway">
<div class="wrap">
<div class="np-hd" data-r=""><p class="disp">{{ section.settings.t_48 }}</p><h2 class="sh2">{{ section.settings.t_49 | escape }}</h2><p class="np-lead2 c">{{ section.settings.t_50 | escape }}</p></div>
<div class="np-way-g">
<div data-r=""><h3>{{ section.settings.t_51 | escape }}</h3><p>{{ section.settings.t_52 | escape }}</p></div>
<div data-r=""><h3>{{ section.settings.t_53 | escape }}</h3><p>{{ section.settings.t_54 | escape }}</p></div>
<div data-r=""><h3>{{ section.settings.t_55 | escape }}</h3><p>{{ section.settings.t_56 | escape }}</p></div>
</div>
</div>
</section>
</div>
