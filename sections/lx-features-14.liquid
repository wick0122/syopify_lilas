<section class="r-founder lx-top lx-n12" id="f7">
<div class="wrap r-founder__grid">
<div class="r-founder__txt" data-r="">
<span class="r-no">{{ section.settings.t_1 | escape }}</span>
<p class="r-en">{{ section.settings.t_2 }}</p>
<h2 class="r-h">{{ section.settings.t_3 | escape }}</h2>
<p>{{ section.settings.t_4 | escape }}</p>
<a class="r-more" href="/pages/lilas-about">{{ section.settings.t_5 }}</a>
<p class="r-use">{{ section.settings.t_6 | escape }}</p>
<p class="r-sign">{{ section.settings.t_7 }}</p>
</div>
<figure class="ph r-founder__ph" data-r=""><img alt="Lilasの開発者" decoding="async" loading="lazy" src="{% if section.settings.img_1 %}{{ section.settings.img_1 | image_url: width: 1800 }}{% else %}{{ 'img-dca828bae116.webp' | asset_url }}{% endif %}"/></figure>
</div>
</section>
{% schema %}
{
  "name": "特徴 14 07 開発者",
  "tag": "div",
  "class": "lx-sec",
  "settings": [
    {
      "type": "image_picker",
      "id": "img_1",
      "label": "画像：Lilasの開発者",
      "info": "未設定のときは元の画像（img-dca828bae116.webp）を表示します"
    },
    {
      "type": "text",
      "id": "t_1",
      "label": "07"
    },
    {
      "type": "html",
      "id": "t_2",
      "label": "From the founder",
      "info": "文字の装飾タグ（<br> や <span> など）を含みます。文字だけ書き換えてください"
    },
    {
      "type": "text",
      "id": "t_3",
      "label": "肌に自信が持てると、表情が、晴れていく。"
    },
    {
      "type": "textarea",
      "id": "t_4",
      "label": "エステ＆アロマサロンと調合スキンケア教室を1…"
    },
    {
      "type": "html",
