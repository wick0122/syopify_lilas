{{ 'lilas-share.css' | asset_url | stylesheet_tag }}

<section class="spread" id="{{ section.settings.anchor | default: 'share' }}">
  <figure class="ph">
    {%- render 'lilas-image', image: section.settings.image, fallback: 'lilas-share.jpg', alt: 'Lilasを手にする2人' -%}
  </figure>
  <div class="after page grid12">
    <h2 data-r>{{ section.settings.heading | escape | newline_to_br }}</h2>
    <div class="r" data-r>
      <p>{{ section.settings.text | escape | newline_to_br }}</p>
      {%- if section.settings.link_label != blank -%}
        <a class="lnk" href="{{ section.settings.link | default: '#collection' }}">
          {{- section.settings.link_label -}}<small>{{ section.settings.link_sub }}</small>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lilas 締め（大きな写真）",
  "settings": [
    { "type": "text", "id": "anchor", "label": "ID", "default": "share" },
    { "type": "image_picker", "id": "image", "label": "大きな写真" },
    { "type": "textarea", "id": "heading", "label": "見出し", "default": "大切な人と、\n分かち合う。" },
    { "type": "textarea", "id": "text", "label": "説明", "default": "性別を問わず使えるから、贈り物にも。\nギフトラッピング(330円)もご用意しています。" },
    { "type": "text", "id": "link_label", "label": "リンクの文字（英字）", "default": "Gift ideas" },
    { "type": "text", "id": "link_sub", "label": "リンクの文字（日本語）", "default": "贈り物を選ぶ" },
    { "type": "url", "id": "link", "label": "リンク先" }
  ],
  "presets": [{ "name": "Lilas 締め（大きな写真）" }]
}
{% endschema %}
