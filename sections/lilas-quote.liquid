{{ 'lilas-quote.css' | asset_url | stylesheet_tag }}

<div class="pull page">
  <q data-r>{{ section.settings.quote | escape | newline_to_br }}</q>
  {%- if section.settings.quote_ja != blank -%}
    <span class="jp" data-r>{{ section.settings.quote_ja }}</span>
  {%- endif -%}
  {%- if section.settings.folio != blank -%}
    <span class="folio">{{ section.settings.folio }}</span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Lilas 引用",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "引用（英語・改行できます）", "default": "Your skin changes.\nYour care, gracefully." },
    { "type": "text", "id": "quote_ja", "label": "日本語", "default": "変わっていく肌と、これからも心地よく。" },
    { "type": "text", "id": "folio", "label": "小さな文字", "default": "Lilas philosophy" }
  ],
  "presets": [{ "name": "Lilas 引用" }]
}
{% endschema %}
