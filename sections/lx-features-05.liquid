<section class="fsec lx-top lx-n3" id="f2"><div class="wrap">
<div class="f2-grid">
<div data-r=""><span class="fno">{{ section.settings.t_1 | escape }}</span><h2 class="fh">{{ section.settings.t_2 | escape | newline_to_br | strip_newlines }}</h2>
<p class="ftx">{{ section.settings.t_3 | escape }}</p></div>
<figure class="ph f2-ph" data-r=""><img alt="鏡の前で、ふたりでローションを肌になじませる様子" decoding="async" loading="lazy" src="{% if section.settings.img_1 %}{{ section.settings.img_1 | image_url: width: 1800 }}{% else %}{{ 'img-16b2edfff84a.webp' | asset_url }}{% endif %}"/></figure>
</div>
<ul class="wy-cases">
<li data-r=""><span class="n">{{ section.settings.t_4 | escape }}</span><h4>{{ section.settings.t_5 | escape }}</h4><p>{{ section.settings.t_6 | escape }}</p></li>
<li data-r=""><span class="n">{{ section.settings.t_7 | escape }}</span><h4>{{ section.settings.t_8 | escape }}</h4><p>{{ section.settings.t_9 | escape }}</p></li>
<li data-r=""><span class="n">{{ section.settings.t_10 | escape }}</span><h4>{{ section.settings.t_11 | escape }}</h4><p>{{ section.settings.t_12 | escape }}</p></li>
<li data-r=""><span class="n">{{ section.settings.t_13 | escape }}</span><h4>{{ section.settings.t_14 | escape }}</h4><p>{{ section.settings.t_15 | escape }}</p></li>
</ul>
<div class="f2-cta" data-r=""><p>{{ section.settings.t_16 }}</p><a class="addcart big" href="/pages/lilas-products">{{ section.settings.t_17 | escape }}</a></div>
</div></section>
{% schema %}
{
