<section class="fsec alt lx-top lx-n4" id="f3"><div class="wrap">
<div class="fhd-in left" data-r=""><span class="fno">{{ section.settings.t_1 | escape }}</span><h2 class="fh">{{ section.settings.t_2 | escape }}</h2></div>
<div class="f3-grid">
<figure class="ph f3-vid" data-r="">{%- assign lxv_1 = section.settings.vid_1 | default: settings.video_features -%}<video aria-label="洗面台の前で、Lilasを手に取る女性" autoplay="" class="blobv" loop="" muted="" playsinline="" poster="{{ 'img-5cd11f582996.webp' | asset_url }}" preload="auto"><source data-src="{% render 'lx-video-src', video: lxv_1 %}" data-src-sp="{% render 'lx-video-src', video: lxv_1, sp: true %}" type="video/mp4"/></video><script>(function(v){if(!v||!matchMedia("(max-width:900px)").matches)return;v.querySelectorAll("source[data-src-sp]").forEach(function(s){s.setAttribute("data-src",s.getAttribute("data-src-sp"))})})(document.currentScript.previousElementSibling)</script></figure>
<div data-r=""><ul class="six6"><li>{{ section.settings.t_3 | escape }}</li><li>{{ section.settings.t_4 | escape }}</li><li>{{ section.settings.t_5 | escape }}</li><li>{{ section.settings.t_6 }}</li><li>{{ section.settings.t_7 | escape }}</li></ul><p class="ftx">{{ section.settings.t_8 | escape }}</p></div>
</div>
</div></section>
