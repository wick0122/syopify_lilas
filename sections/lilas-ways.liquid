{{ 'lilas-ways.css' | asset_url | stylesheet_tag }}

<section class="ways" id="{{ section.settings.anchor | default: 'together' }}">
  <div class="wy-in">
    <div class="wy-hd" data-r>
      <span class="wy-lbl">{{ section.settings.label }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text | newline_to_br }}</p>
    </div>

    <div class="wy-duo" data-r>
      <figure class="ph wy-ph">
        {%- render 'lilas-image', image: section.settings.image, fallback: 'lilas-ways.jpg', alt: '2本のローションを手にする2人' -%}
      </figure>
      <div class="wy-pair">
        <div class="bt">
          {%- render 'lilas-gauge', level: section.settings.left_level, uid: 'ways-l' -%}
          <p class="k">{{ section.settings.pair_kicker }}</p>
          <h3>{{ section.settings.left_title }}</h3>
          <p>{{ section.settings.left_text | escape | newline_to_br }}</p>
        </div>
        <span class="plus" aria-hidden="true">＋</span>
        <div class="bt">
          {%- render 'lilas-gauge', level: section.settings.right_level, uid: 'ways-r' -%}
          <p class="k">{{ section.settings.pair_kicker }}</p>
          <h3>{{ section.settings.right_title }}</h3>
          <p>{{ section.settings.right_text | escape | newline_to_br }}</p>
        </div>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="wy-cases">
        {%- for block in section.blocks -%}
          <li data-r {{ block.shopify_attributes }}>
            <span class="n">{{ block.settings.num }}</span>
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.text }}</p>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="wy-cta" data-r>
      <p>{{ section.settings.cta_text | escape | newline_to_br }}</p>
      <a class="lnk" href="{{ section.settings.cta_link | default: '#collection' }}">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lilas 使い分け",
  "settings": [
    { "type": "text", "id": "anchor", "label": "ID（目次からの移動先）", "default": "together" },
    { "type": "text", "id": "label", "label": "英字ラベル", "default": "Your way" },
    { "type": "text", "id": "heading", "label": "見出し", "default": "1本で、終わらせなくていい。" },
    {
      "type": "textarea", "id": "text", "label": "説明文",
      "info": "改行できます。<b>〜</b> で囲むと下線つきの太字になります",
      "default": "オイルを加える量で、仕上がりが変わるLilas。\n1本をじっくり使うのも、<b>何本かを持って使い分ける</b>のも自由です。\n朝と夜、季節、自分とパートナー。決まった使い方はありません。"
    },
    { "type": "image_picker", "id": "image", "label": "写真（上が丸い形）" },
    { "type": "header", "content": "2つの使い方" },
    { "type": "text", "id": "pair_kicker", "label": "小さな文字", "default": "たとえば" },
    { "type": "text", "id": "left_title", "label": "左：見出し", "default": "さっぱり" },
    { "type": "textarea", "id": "left_text", "label": "左：説明", "default": "オイルを加えずに。\n軽い使い心地で、朝や暑い季節に。" },
    { "type": "range", "id": "left_level", "label": "左：しずくの量", "min": 0, "max": 100, "step": 5, "default": 0, "unit": "%" },
    { "type": "text", "id": "right_title", "label": "右：見出し", "default": "しっとり" },
    { "type": "textarea", "id": "right_text", "label": "右：説明", "default": "オイルを加えて、オールインワンに。\n夜や乾燥する季節に。" },
    { "type": "range", "id": "right_level", "label": "右：しずくの量", "min": 0, "max": 100, "step": 5, "default": 100, "unit": "%" },
    { "type": "header", "content": "最後の一言" },
    { "type": "textarea", "id": "cta_text", "label": "文章", "default": "1本でも、2本でも、3本でも。\n使い方は、あなたの自由に。" },
    { "type": "text", "id": "cta_label", "label": "リンクの文字", "default": "商品を見る" },
    { "type": "url", "id": "cta_link", "label": "リンク先" }
  ],
  "blocks": [
    {
      "type": "case",
      "name": "使い方の例",
      "settings": [
        { "type": "text", "id": "num", "label": "番号", "default": "i." },
        { "type": "text", "id": "title", "label": "見出し", "default": "朝と夜で" },
        { "type": "textarea", "id": "text", "label": "説明", "default": "朝はさっぱり、夜はオイルを加えた1本でしっとり。" }
      ]
    }
  ],
  "presets": [{ "name": "Lilas 使い分け" }]
}
{% endschema %}
