{%- liquid
  assign p = section.settings.product
  assign po = section.settings.oil_product
  assign pg = section.settings.gift_product
-%}
{%- if p -%}
<script>
window.LX_PRICE={{ p.selected_or_first_available_variant.price | divided_by: 100 }};
window.LX_CART={
  variants:[{%- for v in p.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"available":{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  oil:{% if po %}{{ po.selected_or_first_available_variant.id }}{% else %}null{% endif %},
  gift:{% if pg %}{{ pg.selected_or_first_available_variant.id }}{% else %}null{% endif %}
};
</script>
{%- endif -%}
<section class="wrap buy lx-top lx-n1" id="buy">
<div class="gal">
<div aria-label="製品写真" class="thumbs" role="tablist"><button aria-label="写真1" class="on" data-src="{% if section.settings.img_7 %}{{ section.settings.img_7 | image_url: width: 1800 }}{% else %}{{ 'img-913933de36d8.webp' | asset_url }}{% endif %}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_1 %}{{ section.settings.img_1 | image_url: width: 1800 }}{% else %}{{ 'img-31f4352060eb.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真2" data-src="{{ 'img-a2d48f5f5588.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_2 %}{{ section.settings.img_2 | image_url: width: 1800 }}{% else %}{{ 'img-4a11f88a24b2.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真3" data-src="{{ 'img-30e5271cb91c.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_3 %}{{ section.settings.img_3 | image_url: width: 1800 }}{% else %}{{ 'img-cbe0dfa44547.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真4" data-src="{{ 'img-5d129b42503c.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_4 %}{{ section.settings.img_4 | image_url: width: 1800 }}{% else %}{{ 'img-5ca3caac66f1.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真5" data-src="{{ 'img-434acc8592cd.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_5 %}{{ section.settings.img_5 | image_url: width: 1800 }}{% else %}{{ 'img-9f8c67016b61.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真6" data-src="{{ 'img-742623ec809f.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_6 %}{{ section.settings.img_6 | image_url: width: 1800 }}{% else %}{{ 'img-57a5b1305942.webp' | asset_url }}{% endif %}"/></button></div>
<figure class="ph main-ph"><img alt="モイストグロー マルチバーム" decoding="async" id="mainImg" loading="lazy" src="{% if section.settings.img_7 %}{{ section.settings.img_7 | image_url: width: 1800 }}{% else %}{{ 'img-913933de36d8.webp' | asset_url }}{% endif %}"/><span class="stamps"><span class="vg-badge"><svg aria-hidden="true" viewbox="0 0 16 16"><path d="M3 13C3 6 8 3 14 3C14 9 10 13 3 13Z M3 13L9 7" fill="none" stroke="currentColor" stroke-width="1"></path></svg>{{ section.settings.t_1 | escape }}</span></span></figure>
</div>
<div class="info">
<span class="nmb">{{ section.settings.t_2 | escape }}</span>
<h1>{{ section.settings.t_3 }}</h1>
<p class="jp">{{ section.settings.t_4 | escape }}</p><p class="subt">{{ section.settings.t_5 | escape }}</p>
<p class="catch">{{ section.settings.t_6 | escape | newline_to_br | strip_newlines }}</p>
<ul class="chips"><li>{{ section.settings.t_7 | escape }}</li><li>{{ section.settings.t_8 | escape }}</li><li>{{ section.settings.t_9 | escape }}</li><li>{{ section.settings.t_10 | escape }}</li><li>{{ section.settings.t_11 | escape }}</li></ul>
<p class="ag-note"></p>
<div class="price"><b>{{ section.settings.t_12 | escape }}</b><small>{{ section.settings.t_13 | escape }}</small><span class="vol">{{ section.settings.t_14 | escape }}</span></div>
<div aria-label="オプション" class="opt-box" role="group"><label class="opt"><input data-price="330" id="optGift" type="checkbox"/><img alt="" class="ti" decoding="async" loading="lazy" src="{% if section.settings.img_8 %}{{ section.settings.img_8 | image_url: width: 1800 }}{% else %}{{ 'img-3bdc8772dbe5.webp' | asset_url }}{% endif %}"/><span><b>{{ section.settings.t_15 | escape }}</b><small>{{ section.settings.t_16 | escape }}</small></span><span class="p">{{ section.settings.t_17 | escape }}</span></label></div>
<div class="qtyrow">
<div class="qty"><button aria-label="減らす" id="qMinus" type="button">{{ section.settings.t_18 | escape }}</button><output id="qty">{{ section.settings.t_19 | escape }}</output><button aria-label="増やす" id="qPlus" type="button">{{ section.settings.t_20 | escape }}</button></div>
<div class="total"><span>{{ section.settings.t_21 | escape }}</span><b id="total">{{ section.settings.t_22 | escape }}</b></div>
</div>
<button class="addcart big" id="buyBtn">{{ section.settings.t_23 | escape }}</button>
<p class="ship"><span id="shipTx">{{ section.settings.t_24 | escape }}</span><span class="bar"><i id="shipBar" style="width:96%"></i></span></p>
<div class="ingC"><h3>{{ section.settings.t_25 }}</h3><div class="ic-g"><h4>{{ section.settings.t_26 }}</h4><ul class="tiles"><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_9 %}{{ section.settings.img_9 | image_url: width: 1800 }}{% else %}{{ 'img-b59e95669293.webp' | asset_url }}{% endif %}"/><span>{{ section.settings.t_27 | escape }}</span></li><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_10 %}{{ section.settings.img_10 | image_url: width: 1800 }}{% else %}{{ 'img-a9a95b36a5f8.webp' | asset_url }}{% endif %}"/><span>{{ section.settings.t_28 | escape }}</span></li><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_11 %}{{ section.settings.img_11 | image_url: width: 1800 }}{% else %}{{ 'img-e1aba261b351.webp' | asset_url }}{% endif %}"/><span>{{ section.settings.t_29 | escape }}</span></li></ul></div></div>
<ul class="mini"><li>{{ section.settings.t_30 }}</li><li>{{ section.settings.t_31 }}</li></ul>
</div>
</section>
