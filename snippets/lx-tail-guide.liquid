<script>
(function(){var hd=document.querySelector("header.site"),b=document.querySelector(".mbtn");
function setH(){document.documentElement.style.setProperty("--hh",(hd?hd.getBoundingClientRect().height:64)+"px")}setH();addEventListener("resize",setH);
if(b)b.addEventListener("click",function(){var o=hd.classList.toggle("menu");b.setAttribute("aria-expanded",o)});
document.querySelectorAll("header.site nav a").forEach(function(a){a.addEventListener("click",function(){hd.classList.remove("menu")})});
var side=document.getElementById("ipSide"),tgl=document.getElementById("ipTgl"),cur=document.getElementById("ipCur"),links=[].slice.call(document.querySelectorAll(".ip-side nav a")),secs=links.map(function(a){return document.querySelector(a.getAttribute("href"))});
function spy(){var line=(hd?hd.getBoundingClientRect().height:64)+120,idx=0;secs.forEach(function(s,i){if(s&&s.getBoundingClientRect().top<=line)idx=i});if(innerHeight+scrollY>=document.documentElement.scrollHeight-4&&false)idx=secs.length-1;links.forEach(function(a,i){if(i===idx){a.setAttribute("aria-current","true");cur.textContent=a.textContent}else a.removeAttribute("aria-current")})}
addEventListener("scroll",spy,{passive:true});addEventListener("resize",spy);spy();
links.forEach(function(a){a.addEventListener("click",function(){side.classList.remove("open");tgl.setAttribute("aria-expanded","false")})});
tgl.addEventListener("click",function(){var o=side.classList.toggle("open");tgl.setAttribute("aria-expanded",o)});
})();
</script>
