<script>(()=>{document.querySelectorAll(".vt-card").forEach(c=>{const q=c.querySelector("blockquote");requestAnimationFrame(()=>{if(q.scrollHeight>q.clientHeight+2){const b=document.createElement("button");b.type="button";b.className="vt-more";b.textContent="続きを読む";b.onclick=()=>{c.classList.toggle("open");b.textContent=c.classList.contains("open")?"閉じる":"続きを読む"};q.after(b)}})})})();</script>