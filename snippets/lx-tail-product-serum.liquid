<button aria-label="ページの上へ" class="totop" id="totop" type="button">↑</button>
<script>
/* 「ページの上へ」:2画面分ほど読んだら出す */
(()=>{const b=document.getElementById("totop");if(!b)return;const up=()=>b.classList.toggle("on",scrollY>innerHeight*1.5);
 addEventListener("scroll",up,{passive:true});up();b.addEventListener("click",()=>scrollTo({top:0,behavior:"smooth"}))})();
</script>
<script>
/* 目次のタブ:価格の場所を過ぎたら出す。押すとその場所へ、読んでいる場所に下線 */
(()=>{const L=[["voices","口コミ"],["detail","詳細"],["why","特徴"],["craft","こだわり"],["oil-check","分量チェック"],["howto","使い方"]];
 const items=L.filter(([id])=>document.getElementById(id));if(items.length<2)return;
 const nav=document.createElement("nav");nav.className="ptabs";nav.setAttribute("aria-label","このページの目次");
 items.forEach(([id,t])=>{const a=document.createElement("a");a.href="#"+id;a.textContent=t;a.dataset.id=id;nav.appendChild(a)});document.body.appendChild(nav);
 const hd=document.querySelector("header.site"),buy=document.getElementById("buy"),ft=document.querySelector("footer"),mq=matchMedia("(max-width:900px)");
 const hdH=()=>(hd&&!hd.classList.contains("hd-hide"))?Math.max(hd.offsetHeight,hd.getBoundingClientRect().bottom):0;
 function upd(){if(!mq.matches)return;const top=Math.max(0,hdH());nav.style.top=top+"px";
  const show=buy&&buy.getBoundingClientRect().bottom<80&&(!ft||ft.getBoundingClientRect().top>innerHeight*.6);nav.classList.toggle("on",!!show);
  const line=top+nav.offsetHeight+20;let cur=null;items.forEach(([id])=>{const r=document.getElementById(id).getBoundingClientRect();if(r.top<=line)cur=id});
  nav.querySelectorAll("a").forEach(a=>{const on=a.dataset.id===cur;a.classList.toggle("cur",on);if(on&&nav.classList.contains("on")){const ar=a.getBoundingClientRect();if(ar.left<0||ar.right>innerWidth)nav.scrollTo({left:a.offsetLeft-20,behavior:"smooth"})}})}
 addEventListener("scroll",()=>{upd();setTimeout(upd,80)},{passive:true});addEventListener("resize",upd);upd();
 nav.addEventListener("click",e=>{const a=e.target.closest("a");if(!a)return;e.preventDefault();const el=document.getElementById(a.dataset.id);
  const y=el.getBoundingClientRect().top+scrollY-(nav.offsetHeight+4);if(hd)hd.classList.add("hd-hide");scrollTo({top:y,behavior:"smooth"})})})();
</script>
<script>
/* スマホのメニュー:開いている間は後ろのページを止め、メニューの中だけスクロール。1つ開くとほかは閉じる */
(()=>{const h=document.querySelector("header.site");if(!h)return;const mq=matchMedia("(max-width:900px)");
 let keepY=null;const sync=()=>{const open=h.classList.contains("menu")&&mq.matches;const was=document.documentElement.classList.contains("menu-lock");if(open&&!was)keepY=scrollY;document.documentElement.classList.toggle("menu-lock",open);if(!open&&was&&keepY!==null){const y=keepY;keepY=null;document.documentElement.style.scrollSnapType="none";scrollTo({top:y,behavior:"instant"});setTimeout(()=>document.documentElement.style.scrollSnapType="",400)}
  if(open){if(h.classList.contains("hd-hide"))h.classList.remove("hd-hide");const st=()=>document.documentElement.style.setProperty("--mnav-top",Math.round(Math.max(h.offsetHeight,h.getBoundingClientRect().bottom))+"px");st();setTimeout(st,360)}};
 new MutationObserver(sync).observe(h,{attributes:true,attributeFilter:["class"]});addEventListener("resize",sync);
 h.querySelectorAll(".gi > .gt[aria-controls]").forEach(b=>b.addEventListener("click",()=>{if(!mq.matches)return;
  setTimeout(()=>{if(b.getAttribute("aria-expanded")==="true"){h.querySelectorAll(".gi > .gt[aria-controls]").forEach(o=>{if(o!==b&&o.getAttribute("aria-expanded")==="true")o.click()});
   const nav=h.querySelector("nav");const r=b.getBoundingClientRect(),nr=nav.getBoundingClientRect();nav.scrollTo({top:nav.scrollTop+r.top-nr.top-4,behavior:"smooth"})}},30)}))})();
</script>
<script>
/* スマホ用:段落の中の改行のうち、注記(※)や箇条(・)の前など意味のある改行以外を「詰めてよい改行」にする */
(()=>{const keepNext=/^[\s]*[※・◎●○■□\-–—(（「『【]/;const keepPrev=/[：:]\s*$/;
 document.querySelectorAll("main p:not(.lx-pre p) br, main li:not(.lx-pre li) br, main dd:not(.lx-pre dd) br, footer p br").forEach(b=>{
  if(b.closest("h1,h2,h3,h4,.fine,.rx-fine,.oc-note,.pnotes,.qbox-note,small,button,.svc-d,.nw-bd"))return;
  const nx=b.nextSibling?b.nextSibling.textContent||"":"",pv=b.previousSibling?b.previousSibling.textContent||"":"";
  if(keepNext.test(nx)||keepPrev.test(pv)||!nx.trim())return;b.classList.add("sbr")})})();
</script>
<script>
/* メニューボタンの読み上げ名を、開閉に合わせて切り替える */
(()=>{const h=document.querySelector("header.site"),b=h&&h.querySelector(".mbtn");if(!b)return;
 new MutationObserver(()=>{const o=h.classList.contains("menu"),l=o?"メニューを閉じる":"メニュー";if(b.getAttribute("aria-label")!==l)b.setAttribute("aria-label",l);const e=String(o);if(b.getAttribute("aria-expanded")!==e)b.setAttribute("aria-expanded",e)}).observe(h,{attributes:true,attributeFilter:["class"]})})();
