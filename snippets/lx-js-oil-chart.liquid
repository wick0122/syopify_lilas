<script>
// オイル量チャート(製品ページ)
(()=>{const box=document.querySelector(".oc");if(!box)return;
const line=box.dataset.line||"std";
const TYPES={mochi:{n:"バランスの整った肌",e:"Balanced",v:[1,1,1]},sara:{n:"乾燥肌タイプ（軽め）",e:"Slightly dry",v:[.7,.7,.7]},teka:{n:"脂性肌タイプ",e:"Oily",d:"水分不足によるインナードライ状態",v:[.42,.48,.95]},kona:{n:"乾燥肌タイプ",e:"Dry",v:[.55,.55,.55]},mix:{n:"混合肌タイプ",e:"Combination",d:"部分的にテカるのに、一部は乾く",v:[.5,.55,.8],v2:[.6,.6,.45]},sens:{n:"敏感肌タイプ",e:"Sensitive",v:[.34,.34,.34]}};
const R={std:{
 mochi:{s:["ローションのみで、もっちり吸いつくまで重ねづけ","秋頃など、もっちり吸いつかない乾燥を感じる時期は、オイルを少量から"],r:[0,1/3],a:"<b>なし</b>(乾燥時期のみ少量)"},
 sara:{s:["まずはローションを3回重ねづけ","もっちり吸いつかなければ、オイルを3分の1から加える"],r:[1/3,1],a:"<b>3分の1から</b>"},
 teka:{s:["まずはローションをたっぷり重ねづけして、水分補給"],r:[0,1/3],a:"<b>3分の1弱</b>(夏以外)"},
 kona:{s:["まずはローションを3回重ねづけ","もっちり吸いつかなければ、オイルを半量から全量まで加える"],r:[.5,1],a:"<b>半量〜全量</b>"},
 mix:{s:["ローションの回数で調整。全体は1回、乾く部分は3回重ねづけ","それでもつっぱるなら、ブレンドオイルを加える"],r:[0,1/2],a:"<b>なし〜半量</b>"},
 sens:{s:["最初からオイルを3分の1加える","数日使って、「もっちり吸いつく」を目安に少しずつ加減してください。"],r:[1/3,1],a:"<b>3分の1から</b>"}},
 sens:{
 mochi:{s:["ローションに、オイルを少量加えて重ねづけ"],r:[0,1/3],a:"<b>少量</b>"},
 sara:{s:["最初からオイルを3分の1加える","数日使って、「もっちり吸いつく」を目安に少しずつ加減してください。"],r:[1/3,1],a:"<b>3分の1から</b>"},
 teka:{s:["最初からオイルを3分の1加える","数日使って、「もっちり吸いつく」を目安に少しずつ加減してください。"],r:[1/3,1],a:"<b>3分の1から</b>"},
 kona:{s:["最初からオイルを半量加える","数日使って、「もっちり吸いつく」を目安に少しずつ加減してください。"],r:[.5,1],a:"<b>半量〜全量</b>"},
 mix:{s:["オイルを3分の1ほど加える","テカリやすいTゾーンなどは1〜2回、乾く部位は3回重ねづけ"],r:[1/3,1],a:"<b>3分の1〜全量</b>"}}};
function tri(v,v2,small){const cx=100,cy=112,Rr=78,ang=[-90,150,30].map(a=>a*Math.PI/180),pt=(r,i)=>[cx+r*Rr*Math.cos(ang[i]),cy+r*Rr*Math.sin(ang[i])],poly=a=>a.map((r,i)=>pt(r,i).map(n=>n.toFixed(1)).join(",")).join(" ");
 let s=`<svg viewBox="0 0 200 200" role="img" aria-label="水分・水分保持力・保護力のバランス"><defs><radialGradient id="ocbg" cx="50%" cy="56%" r="50%"><stop offset="0" stop-color="#E2E1EA"/><stop offset="1" stop-color="#E2E1EA" stop-opacity="0"/></radialGradient></defs><circle cx="100" cy="110" r="96" fill="url(#ocbg)"/>`;
 s+=`<polygon points="${poly([1,1,1])}" fill="rgba(255,255,255,.5)" stroke="#fff" stroke-width="2.5"/>`;
 [0,1,2].forEach(i=>{const p=pt(1,i);s+=`<line x1="${cx}" y1="${cy}" x2="${p[0]}" y2="${p[1]}" stroke="#fff" stroke-width="1.2"/>`});
 if(v2)s+=`<polygon points="${poly(v2)}" fill="none" stroke="#9AA3D0" stroke-width="1.2" stroke-dasharray="3 3"/>`;
 s+=`<polygon points="${poly(v)}" fill="rgba(182,190,228,.62)" stroke="#9AA3D0" stroke-width="1.3"/>`;
 [["水分",100,22,"middle"],["水分保持力",20,196,"start"],["保護力",180,196,"end"]].forEach(([t,x,y,a])=>s+=`<text x="${x}" y="${y}" text-anchor="${a}" font-size="13.2" fill="#585856" font-family="Shippori Mincho,serif">${t}</text>`);
 return s+"</svg>"}
const el=id=>document.getElementById(id);
function show(k){const t=TYPES[k],r=R[line][k]||R.std[k];
 el("ocTri").innerHTML=k==="mix"?`<div class="oc-tri2"><figure>${tri([.55,.55,.55])}<figcaption>乾く部分</figcaption></figure><figure>${tri([.42,.48,.95])}<figcaption>テカる部分</figcaption></figure></div>`:tri(t.v);
 el("ocType").innerHTML=`${t.d?`<span class="oc-d">${t.d}</span>`:""}${t.n}<small>${t.e}</small>`;el("ocChips").innerHTML=(CH[k]||[]).map(x=>`<span class="oc-chip"><i></i>${x}</span>`).join("");
 el("ocSteps").innerHTML=r.s.map(x=>`<li>${x}</li>`).join("");
 const g=el("ocRange");const a=r.r[0],b=r.r[1];g.style.left=(a*100)+"%";g.style.width=(Math.max(b-a,.02)*100)+"%";if(b===0){g.style.width="10px";g.style.left="0"}
 el("ocAmt").innerHTML=r.a;
 cur=k;el("ocTx").innerHTML=OTX[k]||"";box.querySelectorAll(".oc-types button,.oc-feelopts button").forEach(x=>{const on=x.dataset.k===k;x.classList.toggle("on",on);if(x.hasAttribute("aria-checked"))x.setAttribute("aria-checked",on)});envNotes()}
const OTX={mochi:"濃縮ローションにブレンドオイルの追加は不要だと言えますが、秋頃からなど季節によってもっちり吸いつかない乾燥を感じる時期は、ブレンドオイルを追加して調整しましょう。",sara:"濃縮ローションにブレンドオイルを少し加えるのがおすすめ。秋頃からなど季節によって強い乾燥を感じる前には、ブレンドオイルを追加して調整しましょう。",teka:"保湿が足りないと水分量に対し、油分が過剰になりやすく、テカリやキメの乱れにも繋がります。隠れ乾燥肌の可能性が。<br>濃縮ローションの重ねづけで様子を見てください。乾燥時期や、もっちり感を感じない方は、油分も不足している可能性が。ブレンドオイルを追加して調整してください。",kona:"濃縮ローションにブレンドオイルを多めに加えるのがおすすめ。",mix:"部位ごとにスキンケアの仕方を変えるのがポイント。",sens:"濃縮ローションに、診断結果のオイル量を加えるのがおすすめ。特に最近でも敏感な方、乾燥やガサガサ感が気になる方は、寝る前はご自宅ではマルチバームの保護もおすすめします。"};
const CH={mochi:["水分・水分保持・保護の3つとも足りている"],sara:["水分・水分保持・保護の3つとも不足"],kona:["水分・水分保持・保護の3つとも不足"],teka:["水分・水分保持が不足"],mix:["テカる部分：水分・水分保持が不足","乾燥部分：油分も不足"],sens:["水分・水分保持・保護の3つとも不足"]};
const STAT={mochi:"今のスキンケアは、<br>水分・水分保持・保護の3つとも足りています",sara:"今のスキンケアは、<br>水分・水分保持・保護の3つとも不足",kona:"今のスキンケアは、<br>水分・水分保持・保護の3つとも不足",teka:"今のスキンケアは、<br>水分・水分保持の2つが不足",mix:"今のスキンケアは、<br>テカる部分：水分と水分保持が不足<br>乾燥部分：油分も不足",sens:"今のスキンケアは、<br>水分・水分保持・保護の3つとも不足"};
const ENV={dry:1,uv:1,sweat:1};let cur="";
function envNotes(){const on=[...box.querySelectorAll(".oc-env button.on")].map(b=>b.dataset.e);const k=cur;
 el("ocEnvLine").innerHTML="";
 const EB={dry:["秋冬、エアコンの部屋で過ごすことが多い方は？","空気が乾燥する環境では、うるおいが逃げやすくなります。ブレンドオイルを少し加えてください。"],uv:["外で紫外線を浴びることが多い方は？","日差しを浴びた日の肌は、乾燥しやすい状態です。ブレンドオイルを加え、重ねづけを。"],sweat:["汗をよくかき、日中も顔を洗うことが多い方は？","汗や洗顔のたびに、うるおいも流れやすくなります。洗うたび、濃縮ローションを重ねづけしてください。"]};
 const envs=["dry","uv","sweat"].filter(e=>on.includes(e));const nose=on.includes("nose");
 let boxes=envs.map(e=>[EB[e][0],EB[e][1]]);
 if(boxes.length&&!nose)boxes[boxes.length-1][1]+="<br>※特に乾燥を強く感じる方：仕上げにマルチバームで保護するのがおすすめ。";
 let h=boxes.map(b=>`<div class="oc-envbox"><p class="oc-env-h">${b[0]}</p><p>${b[1]}</p></div>`).join("");
 if(nose)h+=`<div class="oc-envbox"><p class="oc-env-h">鼻をかむことが多い・擦れやすい方は？</p><p>先にマルチバームで保護してから、カームスムースを重ねづけするのがおすすめです。</p></div>`;
 else if(!boxes.length&&(k==="kona"||k==="mix"))h+=`<p>乾燥が気になる箇所は、お好みでマルチバームで仕上げを。</p>`;
 el("ocEnv").innerHTML=h;el("ocFine").innerHTML=nose?"※傷・湿疹がある部位、しみるときは使用を控えてください。<br>皮膚科で治療中の方は、医師の指示を優先してください。":""}
box.querySelectorAll(".oc-env button").forEach(b=>b.addEventListener("click",()=>{const e=b.dataset.e;if(e==="none"){box.querySelectorAll(".oc-env button").forEach(x=>{const on=x===b&&!b.classList.contains("on");x.classList.toggle("on",on);x.setAttribute("aria-pressed",on)})}else{const on=!b.classList.contains("on");b.classList.toggle("on",on);b.setAttribute("aria-pressed",on);const n=box.querySelector('.oc-env button[data-e="none"]');n.classList.remove("on");n.setAttribute("aria-pressed","false")}envNotes()}));
const odlg=box.querySelector("#ocDlg");const setStep=n=>{box.dataset.step=n;box.classList.toggle("done",n===3);box.classList.add("q1done");if(n>=2){if(!odlg.open)odlg.showModal();odlg.scrollTop=0}else if(odlg.open)odlg.close()};box.dataset.step=1;
odlg.addEventListener("close",()=>{box.dataset.step=1});odlg.addEventListener("click",e=>{if(e.target===odlg)odlg.close()});box.querySelector(".oc-dlg-x").addEventListener("click",()=>odlg.close());
box.querySelectorAll(".oc-types button,.oc-feelopts button").forEach(b=>b.addEventListener("click",()=>{show(b.dataset.k);const f=box.querySelector(".oc-feel");if(f)f.open=false;setTimeout(()=>setStep(2),180)}));
box.querySelectorAll(".oc-back").forEach(b=>b.addEventListener("click",()=>{const to=+b.dataset.to;if(to===0){box.querySelectorAll(".oc-env button.on,.oc-types button.on,.oc-feelopts button.on").forEach(x=>{x.classList.remove("on");x.setAttribute("aria-pressed","false");if(x.hasAttribute("aria-checked"))x.setAttribute("aria-checked","false")});box.querySelector(".oc-go").disabled=true;setStep(1)}else setStep(to)}));
const go=box.querySelector(".oc-go");const upd=()=>{go.disabled=!box.querySelector(".oc-env button.on")};box.querySelectorAll(".oc-env button").forEach(b=>b.addEventListener("click",upd));
go.addEventListener("click",()=>{envNotes();setStep(3)});
})();
</script>