<script>
/* 右下の浮かぶボタン:02を読んだ後に「肌タイプチェック」、フッターの手前で「ページの上へ」、肌タイプチェックの欄では隠す */
(()=>{const b=document.getElementById("fab1");if(!b)return;const yw=document.getElementById("yourway"),fm=document.getElementById("formula"),ft=document.querySelector("footer");
 function upd(){const vh=innerHeight;const past=yw?yw.getBoundingClientRect().bottom<vh*.4:scrollY>vh;const ftop=ft?ft.getBoundingClientRect().top:1e9;const nearF=ftop<vh*1.1;
  const r=fm?fm.getBoundingClientRect():null;const inF=r&&r.top<vh*.7&&r.bottom>vh*.3;
  b.classList.toggle("totop",nearF);b.classList.toggle("on",(past&&!inF)||nearF);b.setAttribute("href",nearF?"#top":"#formula");b.setAttribute("aria-label",nearF?"ページの上へ":"肌タイプチェックへ")}
 addEventListener("scroll",upd,{passive:true});addEventListener("resize",upd);upd();
 b.addEventListener("click",e=>{if(b.classList.contains("totop")){e.preventDefault();scrollTo({top:0,behavior:"smooth"})}})})();
</script>
