// ローションは質問1(悩み)と質問2(刺激)、肌タイプとオイルの量は質問3(30分後の肌)で決める
const P={aging:{n:"エイジングケア",s:"濃縮ローション ・ 肌にハリを与える",p:12100},bright:{n:"ブライトアップ",s:"濃縮ローション ・ 肌にツヤを与え、キメを整える",p:12100},smooth:{n:"スムーススキン",s:"濃縮ローション ・ キメを整える",p:11000,wait:true},sensitive:{n:"センシティブケア",s:"濃縮ローション ・ 予約販売(12月5日発送)",p:"¥5,060〜"},calm:{n:"カームスムース",s:"濃縮ローション ・ 肌荒れを防ぎ、キメを整える",p:"¥6,490〜"},oil:{n:"ブレンドオイル",s:"ローションに加えて、よりしっとりと",p:1320},balm:{n:"マルチバーム",s:"お好みで ・ 乾きやすいところに",p:4290}};
const QS={k:"s",t:"化粧品を使ったとき、<br>赤みやヒリヒリ感、肌荒れを<br>感じたことはありますか？",o:[["often","今もよく感じる"],["past","過去に感じたことがある"],["no","とくにない"]]};
const QT={k:"t",t:"赤みやヒリヒリ感を感じたのは、<br>どれくらい前ですか？",o:[["1y","1年以内"],["2y","2〜3年前"],["old","それ以上前"]]};
