const OIL={std:{mochi:{s:["ローションのみで、もっちり吸いつくまで重ねづけ"],a:""},sara:{s:["まずはローションを3回重ねづけ","もっちり吸いつかなければ、オイルを3分の1から"],a:"3分の1から、吸いつくまで"},teka:{s:["まずはローションを3回重ねづけ","しっとり感がほしくなったら、オイルを3分の1から"],a:"数日はローションのみ。その後3分の1から"},kona:{s:["まずはローションを3回重ねづけ","吸いつかなければ、オイルを半量から全量まで"],a:"半量から全量まで"},mix:{s:["オイルを3分の1ほど加える","テカる部位は2回、乾く部分は3回重ねづけ"],a:"3分の1ほど。半量〜全量に加減"}},
 sens:{mochi:{s:["ローションにオイルを少量加え、重ねづけ"],a:"少量から、必要に応じて"},sara:{s:["最初からオイルを3分の1加える","もっちり吸いつくまで、少しずつ増やす"],a:"3分の1から、吸いつくまで"},teka:{s:["最初からオイルを3分の1加える","もっちり吸いつくまで、少しずつ増やす"],a:"3分の1から、吸いつくまで"},kona:{s:["最初からオイルを半量加える","様子を見て、全量まで増やす"],a:"半量から全量まで"},mix:{s:["オイルを3分の1ほど加える","テカる部位は2回、乾く部分は3回重ねづけ"],a:"3分の1ほど。半量〜全量に加減"}}};
function triSvg(v,v2){const cx=100,cy=112,R=78,ang=[-90,150,30].map(a=>a*Math.PI/180),pt=(r,i)=>[cx+r*R*Math.cos(ang[i]),cy+r*R*Math.sin(ang[i])],poly=a=>a.map((r,i)=>pt(r,i).map(n=>n.toFixed(1)).join(",")).join(" ");
 let s=`<svg viewBox="0 0 200 204" role="img" aria-label="水分・水分保持力・保護力のバランス"><polygon points="${poly([1,1,1])}" fill="rgba(255,255,255,.5)" stroke="#fff" stroke-width="2.5"/>`;
 [0,1,2].forEach(i=>{const p=pt(1,i);s+=`<line x1="${cx}" y1="${cy}" x2="${p[0]}" y2="${p[1]}" stroke="#fff" stroke-width="1.2"/>`});
 if(v2)s+=`<polygon points="${poly(v2)}" fill="none" stroke="#9AA3D0" stroke-width="1.2" stroke-dasharray="3 3"/>`;
 s+=`<polygon points="${poly(v)}" fill="rgba(182,190,228,.62)" stroke="#9AA3D0" stroke-width="1.3"/>`;
 [["水分",100,22,"middle"],["水分保持力",18,200,"start"],["保護力",182,200,"end"]].forEach(([t,x,y,a])=>s+=`<text x="${x}" y="${y}" text-anchor="${a}" font-size="11" fill="#585856" font-family="Shippori Mincho,serif">${t}</text>`);
 return s+"</svg>"}
const yen=n=>"¥"+n.toLocaleString("ja-JP");
const dlg=$("#dlg"),body=$("#dlgBody");let ans={},st=0;
function render(){
  const L=qList();
  if(st<L.length){const q=L[st];const tot=L.length+1;body.innerHTML=`<span class="dl">QUESTION ${st+2} / ${tot}</span><h3>${q.t}</h3>${q.o.map(([v,l])=>`<button class="choice" data-v="${v}">${l}</button>`).join("")}<button class="back rx-b-back" id="bk">${st?'<span aria-hidden="true">←</span>ひとつ戻る':"閉じる"}</button>`;
    body.querySelectorAll(".choice").forEach(b=>b.onclick=()=>{ans[q.k]=b.dataset.v;if(q.k==="s"&&b.dataset.v!=="past")delete ans.t;st++;render()});$("#bk").onclick=()=>{if(st){st--;render()}else dlg.close()};return;}
  const {c,s,t,d}=ans;
  const sens=s==="often"||(s==="past"&&t==="1y");      // 今も感じる・1年以内 → 敏感肌タイプ
  const pastOld=s==="past"&&t!=="1y";                  // 2年以上前 → 悩みに合うローション＋注意書き
  let lots,title;
  if(sens){lots=["calm"];title="まずは、やさしく守る。"}
  else if(c==="smooth"){lots=["calm","bright"];title="キメを、整える。"}
  else if(c==="dry"||c==="rough"){lots=["calm"];title="ゆらぎを防ぎ、整える。"}
  else if(c==="bright"){lots=["bright"];title="ツヤを、与える。"}
  else{lots=["aging"];title="ハリを、与える。"}
  const lot=lots[0];
  const tt=sens?TT.sens:TT[d];
  const useOil=true;
  const useBalm=sens||d==="kona"||d==="mix";
  const OILMSG={mochi:"ブレンドオイルは、乾燥時期のみ追加",sara:"ブレンドオイルを少し加えるのがおすすめ",teka:"秋頃から、ブレンドオイルを少しだけ追加",kona:"ブレンドオイルを多めに加えるのがおすすめ",mix:"乾く部分がつっぱるなら、ブレンドオイルを追加"};
  const TYN={mochi:"バランスの整った肌タイプ",sara:"乾燥肌タイプ（軽め）",teka:"水分不足による（隠れ乾燥）脂性肌タイプ",kona:"乾燥肌タイプ",mix:"隠れ乾燥の混合肌タイプ",sens:"敏感肌タイプ"};
  const SHORT={mochi:"水分・水分保持・保護の3つとも、足りています。",sara:"3つとも少し不足。ブレンドオイルを少し加えて。",teka:"まずは、たっぷりの水分補給がおすすめ。",kona:"3つとも不足。ブレンドオイルを多めに加えて。",mix:"部位によって調整。乾く部分は重ねづけを。",sens:"ブレンドオイルを加えて、やさしく守りましょう。"};
  const TXT={mochi:"水分・水分保持・保護の3つとも足りているようなので、濃縮ローションにブレンドオイルの追加は不要だと言えますが、秋頃からなど季節によってもっちり吸いつかない乾燥を感じる時期は、ブレンドオイルを追加して調整しましょう。",
   sara:"水分・水分保持・保護の3つとも不足しているので、濃縮ローションにブレンドオイルを少し加えるのがおすすめ。秋頃からなど季節によって強い乾燥を感じる前には、ブレンドオイルを追加して調整しましょう。",
   teka:"保湿が足りないと、お肌はそれを守るため過剰な油を出やすくなります。まずはたっぷりの水分補給がおすすめ。水分・水分保持の2つが不足しているので、濃縮ローションの重ねづけで様子を見ながら、秋頃からブレンドオイルを少しだけ追加して調整しましょう。",
   kona:"水分・水分保持・保護の3つとも不足しているようなので、濃縮ローションにブレンドオイルを多めに加えるのがおすすめ。",
   sens:"水分・水分保持・保護の3つとも不足しているようなので、濃縮ローションにブレンドオイルを加えるのがおすすめ。<br>特に最近でも敏感な方、乾燥やガサガサ感が気になる方は、寝る前はご自宅ではマルチバームの保護もおすすめします。",
   mix:"体質による影響もあり、一部は、水分・水分保持の2つとも不足。乾く部位は油分も不足しているため、濃縮ローションの回数で調整しましょう。全体は1回。乾く部分は3回重ね、それでもつっぱるなら、ブレンドオイルを加えるのがおすすめ。"};
  const oilMsg=sens?"ブレンドオイルを加えて、肌を守るのがおすすめ":OILMSG[d];
  const OCP={calm:"/pages/lilas-product-calmsmooth",aging:"/pages/lilas-product-aging",bright:"/pages/lilas-product-bright"};
  const ocHref=OCP[lot]+"#oil-check";
  const PRICE={calm:"50ml ¥6,490／110ml ¥11,000"};
  const row=(k,sub,plus)=>{const x=P[k];const nm=OCP[k]?`<a class="rx-pn" href="${OCP[k]}">${x.n}<span aria-hidden="true"> →</span></a>`:x.n;return `<li class="rx-row"><span>${plus?'<b class="rx-plus">＋</b>':""}${nm}</span><i>${PRICE[k]||(typeof x.p==="string"?x.p:yen(x.p))}</i><small class="rx-sub">${sub||x.s}</small></li>`};
  const ocLink=k=>`<li class="rx-oc-li"><a class="rx-oc" href="${OCP[k]}?skin=${sens?"sens":d}#oil-check">肌タイプの解説と、${P[k].n}を見る<span aria-hidden="true">→</span></a></li>`;
  let li=lots.map(k=>row(k)+(useOil?ocLink(k):"")).join("");
  if(useOil)li+=row("oil",oilMsg,true);
  const notes=[];
  if(sens)notes.push("カームスムースから始めて、問題がなければ、ほかの種類に移ることもできます。");
  
  const past=(pastOld||sens)?`<div class="rx-pastd"><p class="rx-pastd-h">${pastOld?"過去に敏感肌の経験がある方へ":"はじめて使う方へ(切り替え方)"}</p><div class="rx-pastc"><p>生理前後や妊娠・出産前後や、アレルギー体質で炎症が出ている方は、免疫やホルモンバランスなどの影響で、肌が敏感に傾きやすい時期です。<br>新しいスキンケアへの切り替えは、肌が落ち着いてからがおすすめです。</p><p class="q">心配な方は？</p><p>カームスムース(ブレンドオイルを加えて)からお試しください。</p><p class="q">新しいスキンケアに変える時は？</p><p>最初の数日は、お手持ちのスキンケアかお水と手のひらで1:1に混ぜて使い、肌を慣らしてから切り替えるのがおすすめです。</p></div></div>`:"";
  body.innerHTML=`<div class="rx rx-a"><div class="rx-dark"><span class="dl">YOUR RECOMMENDATION</span><div class="rx-hd rx-hd-a"><div><p class="rx-lead">あなたは今、</p><h3 class="rx-tyname">${TYN[sens?"sens":d]}</h3><p class="rx-lead rx-lead2">の可能性があります。</p></div></div></div>${notes.map(n=>`<p class="rx-note">${n}</p>`).join("")}
   <p class="rx-h rx-h2">${title.replace(/、/g,"").replace("。","")}、おすすめは？${lots.length>1?`<span class="rx-two">2本から、お好みでお選びください。</span>`:""}</p><ul>${li}</ul>${past}<div class="rx-back"><button class="back rx-b-back" id="rxBack" type="button"><span aria-hidden="true">←</span>ひとつ戻る</button><button class="back rx-b-restart" id="rxRestart" type="button"><span aria-hidden="true">↻</span>最初からやり直す</button></div><p class="fine rx-fine">チェック結果は目安です。肌に合わないときは使用をおやめください。${lot==="aging"?"<br>※エイジングケア:年齢に応じたうるおいケアのこと":""}</p></div>`;
  const rb=body.querySelector("#rxBack");if(rb)rb.onclick=()=>{st=qList().length-1;render()};const rr=body.querySelector("#rxRestart");if(rr)rr.onclick=()=>{st=0;delete ans.s;delete ans.t;delete ans.d;render()};
  
}
