{% render 'lx-js-news-panel' %}
<script>
document.documentElement.classList.add("js");
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("shown");io.unobserve(e.target)}}),{rootMargin:"0px 0px -10% 0px"});
$$("[data-r]").forEach(el=>io.observe(el));
// 写真の切り替え
const mainImg=$("#mainImg");
$$(".thumbs button").forEach(b=>b.onclick=()=>{$$(".thumbs button").forEach(x=>x.classList.toggle("on",x===b));mainImg.style.opacity=0;setTimeout(()=>{mainImg.src=b.dataset.src;mainImg.style.opacity=1},250)});
// 合計と送料無料までの残り
let BASE=(window.LX_PRICE||10670),FREE=14000;let q=1;const yen=n=>"¥"+n.toLocaleString("ja-JP");
function calc(){let t=BASE*q;$$(".opt input").forEach(i=>{if(i.checked)t+=+i.dataset.price});
  $("#total").textContent=yen(t);$("#sbarPr").textContent=yen(t);$("#qty").textContent=q;
  const r=FREE-t;$("#shipTx").textContent=r>0?`あと${yen(r)}で送料無料`:"送料無料でお届けします";$("#shipBar").style.width=Math.min(100,t/FREE*100)+"%";return t}
$$(".opt input").forEach(i=>i.onchange=calc);
$("#qMinus").onclick=()=>{q=Math.max(1,q-1);calc()};$("#qPlus").onclick=()=>{q=Math.min(9,q+1);calc()};calc();
// カート(見本)
let cartN=0;const toast=document.createElement("div");toast.className="toast";toast.setAttribute("role","status");document.body.appendChild(toast);let tt;
function addCart(n,name){cartN+=n;$$(".cartn").forEach(e=>e.textContent=cartN);toast.textContent=`${name}をカートに入れました`;toast.classList.add("on");clearTimeout(tt);tt=setTimeout(()=>toast.classList.remove("on"),2600)}
const buy=()=>{let n=q;$$(".opt input").forEach(i=>{if(i.checked)n++});addCart(n,"ギフトセット スタートキット")};
$("#buyBtn").onclick=buy;$("#sbarBtn").onclick=buy;
$$(".addcart[data-name]").forEach(b=>b.onclick=()=>addCart(1,b.dataset.name));
// セラムの容量
$$(".size").forEach(g=>{const card=g.closest("article");g.querySelectorAll("button").forEach(b=>b.onclick=()=>{g.querySelectorAll("button").forEach(x=>x.classList.toggle("on",x===b));card.querySelector(".pv").textContent=b.dataset.p;card.querySelector(".addcart").dataset.name="モイストヴェールセラム "+b.dataset.s})});
// 下部の購入バー:購入エリアを過ぎたら表示
const sbar=$("#sbar"),buyEl=$("#buyBtn");
/* 上メニューと下のカートバーを、スクロールの向きで切り替える */(()=>{const hd=document.querySelector("header.site");let lastY=window.scrollY,ticking=false;const upd=()=>{ticking=false;const y=window.scrollY,dy=y-lastY;const passed=buyEl.getBoundingClientRect().bottom<0;if(!passed){sbar.classList.remove("on");hd&&hd.classList.remove("hide");lastY=y;return}if(hd&&hd.classList.contains("menu")){lastY=y;return}if(Math.abs(dy)<6)return;if(dy>0){sbar.classList.add("on");hd&&hd.classList.add("hide")}else{sbar.classList.remove("on");hd&&hd.classList.remove("hide")}lastY=y};window.addEventListener("scroll",()=>{if(!ticking){ticking=true;requestAnimationFrame(upd)}},{passive:true});upd()})();
// 考え方の引き出し
const openN=$("#openNotes");const setN=on=>{document.body.classList.toggle("notes",on);openN.setAttribute("aria-expanded",on)};
openN.onclick=()=>setN(true);$("#closeNotes").onclick=()=>setN(false);$("#scrim").onclick=()=>setN(false);
document.addEventListener("keydown",e=>{if(e.key==="Escape")setN(false)});
</script>
