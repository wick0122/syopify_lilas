<script>
document.documentElement.classList.add("js");
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("shown");io.unobserve(e.target)}}),{rootMargin:"0px 0px -10% 0px"});
document.querySelectorAll("[data-r]").forEach(el=>io.observe(el));
const openN=document.getElementById("openNotes");const setN=on=>{document.body.classList.toggle("notes",on);openN.setAttribute("aria-expanded",on)};
openN.onclick=()=>setN(true);document.getElementById("closeNotes").onclick=()=>setN(false);document.getElementById("scrim").onclick=()=>setN(false);
document.addEventListener("keydown",e=>{if(e.key==="Escape")setN(false)});
</script>