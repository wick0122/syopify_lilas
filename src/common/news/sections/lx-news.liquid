<script>
window.LILAS_NEWS = [
{%- for b in section.blocks -%}
  {
    "date": {{ b.settings.date | json }},
    "label": {{ b.settings.label | json }},
    "title": {{ b.settings.title | json }}
    {%- if b.settings.body != blank -%},"body": {{ b.settings.body | json }}{%- endif -%}
    {%- if b.settings.link != blank -%},"link": {{ b.settings.link | json }}, "linkText": {{ b.settings.link_text | json }}{%- endif -%}
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
];
</script>
{% schema %}
{
  "name": "お知らせ（News）",
  "tag": "div",
  "class": "lx-sec",
  "settings": [
    {"type": "paragraph", "content": "画面右上のベルや「NEWS」から開くお知らせ一覧です。新しいお知らせは、いちばん上に追加してください。"}
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "item",
      "name": "お知らせ",
      "settings": [
        {"type": "text", "id": "date", "label": "日付（並べ替え用）", "info": "例：2026-11-05"},
        {"type": "text", "id": "label", "label": "画面に出す日付", "info": "例：2026.11.05"},
        {"type": "text", "id": "title", "label": "タイトル"},
        {"type": "textarea", "id": "body", "label": "本文（なくてもOK）"},
        {"type": "text", "id": "link", "label": "リンク先（なくてもOK）", "info": "例：/pages/lilas-product-calmsmooth"},
        {"type": "text", "id": "link_text", "label": "リンクの文字"}
      ]
    }
  ],
  "presets": [{"name": "お知らせ（News）"}]
}
{% endschema %}
