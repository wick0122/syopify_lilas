<section class="vcs lx-top lx-n2" id="voices">
<span class="qlbl" data-r="">{{ section.settings.t_1 | escape }}</span>
<p class="disp" data-r=""><em>{{ section.settings.t_2 | escape }}</em></p>
<div class="vc-hdrow" data-r=""><h2 class="sh2">{{ section.settings.t_3 | escape }}</h2></div>
<div class="vc-jdgm" data-r="">
{%- for block in section.blocks -%}{% render block %}{%- endfor -%}
</div>
<p class="vc-note">{{ section.settings.t_20 | escape }}</p>
</section>
{% schema %}
{
  "name": "お客様の声（製品ページ）",
  "tag": "div",
  "class": "lx-sec",
  "settings": [
    {
      "type": "text",
      "id": "t_1",
      "label": "Voices"
    },
    {
      "type": "text",
      "id": "t_2",
      "label": "Voices"
    },
    {
      "type": "text",
      "id": "t_3",
      "label": "お客様の口コミ"
    },
    {
      "type": "text",
      "id": "t_20",
      "label": "※口コミは、ご購入いただいたお客様の投稿です…"
    },
    {
      "type": "header",
      "content": "Judge.meの口コミ"
    },
    {
      "type": "paragraph",
      "content": "口コミは、この欄に追加したJudge.meのブロックで表示します。ここで選んだ商品は控えとして残しています。"
    },
    {
      "type": "product",
      "id": "product",
      "label": "口コミを表示する商品"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
