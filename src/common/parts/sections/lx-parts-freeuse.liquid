<section class="np-sec np-alt np-way lx-top lx-n7" id="yourway">
<div class="wrap">
<div class="np-hd" data-r=""><p class="disp">{{ section.settings.t_1 }}</p><h2 class="sh2">{{ section.settings.t_2 | escape }}</h2><p class="np-lead2 c">{{ section.settings.t_3 | escape }}</p></div>
<div class="np-way-g">
<div data-r=""><h3>{{ section.settings.t_4 | escape }}</h3><p>{{ section.settings.t_5 | escape }}</p></div>
<div data-r=""><h3>{{ section.settings.t_6 | escape }}</h3><p>{{ section.settings.t_7 | escape }}</p></div>
<div data-r=""><h3>{{ section.settings.t_8 | escape }}</h3><p>{{ section.settings.t_9 | escape }}</p></div>
</div>
</div>
</section>
{% schema %}
{
  "name": "肌に合わせて、使い方も自由に",
  "tag": "div",
  "class": "lx-sec",
  "settings": [
    {
      "type": "html",
      "id": "t_1",
      "label": "Your way",
      "info": "文字の装飾タグ（<br> や <span> など）を含みます。文字だけ書き換えてください"
    },
    {
      "type": "text",
      "id": "t_2",
      "label": "肌に合わせて、使い方も自由に"
    },
    {
      "type": "text",
      "id": "t_3",
      "label": "1本でも、オールインワンとして使えるLila…"
    },
    {
      "type": "text",
      "id": "t_4",
      "label": "2本使い"
    },
    {
      "type": "text",
      "id": "t_5",
      "label": "1種はそのまま顔全体に。もう1種はオイルを加…"
    },
    {
      "type": "text",
      "id": "t_6",
      "label": "季節で"
    },
    {
      "type": "text",
      "id": "t_7",
      "label": "乾燥する季節はオイルを追加して調整、夏はその…"
    },
    {
      "type": "text",
      "id": "t_8",
      "label": "ふたりで"
    },
    {
      "type": "text",
      "id": "t_9",
      "label": "同じ1本を2人で、重ねる回数でそれぞれの肌に…"
    }
  ]
}
{% endschema %}
