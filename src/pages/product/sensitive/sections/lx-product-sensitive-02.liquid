{%- liquid
  assign p = section.settings.product
  assign po = section.settings.oil_product
  assign pg = section.settings.gift_product
-%}
{%- if p -%}
<script>
window.LX_PRICE={{ p.selected_or_first_available_variant.price | divided_by: 100 }};
window.LX_CART={
  variants:[{%- for v in p.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"available":{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  oil:{% if po %}{{ po.selected_or_first_available_variant.id }}{% else %}null{% endif %},
  gift:{% if pg %}{{ pg.selected_or_first_available_variant.id }}{% else %}null{% endif %}
};
</script>
{%- endif -%}
<section class="wrap buy lx-top lx-n1" id="buy">
<div class="gal">
<div aria-label="製品写真" class="thumbs" role="tablist"><button aria-label="写真1" class="on" data-src="{% if section.settings.img_2 %}{{ section.settings.img_2 | image_url: width: 1800 }}{% else %}{{ 'img-001f5c275da4.webp' | asset_url }}{% endif %}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_1 %}{{ section.settings.img_1 | image_url: width: 1800 }}{% else %}{{ 'img-13488294a854.webp' | asset_url }}{% endif %}"/></button></div>
<figure class="ph main-ph"><img alt="センシティブケア" decoding="async" id="mainImg" loading="lazy" src="{% if section.settings.img_2 %}{{ section.settings.img_2 | image_url: width: 1800 }}{% else %}{{ 'img-001f5c275da4.webp' | asset_url }}{% endif %}"/><span class="stamps"><span class="vg-badge"><svg aria-hidden="true" viewbox="0 0 16 16"><path d="M3 13C3 6 8 3 14 3C14 9 10 13 3 13Z M3 13L9 7" fill="none" stroke="currentColor" stroke-width="1"></path></svg>{{ section.settings.t_1 | escape }}</span><span class="salebdg sold">{{ section.settings.t_2 | escape }}</span></span></figure>
</div>
<div class="info">
<span class="nmb">{{ section.settings.t_3 | escape }}</span>
<h1>{{ section.settings.t_4 }}</h1>
<p class="jp">{{ section.settings.t_5 | escape }}</p>
<p class="catch"><span class="catch-t">{{ section.settings.t_6 | escape }}</span></p>
<p class="rec-for">{{ section.settings.t_7 | escape }}</p><p class="rec-for">{{ section.settings.t_8 | escape }}</p><ul class="chips"><li>{{ section.settings.t_9 | escape }}</li><li>{{ section.settings.t_10 | escape }}</li><li>{{ section.settings.t_11 | escape }}</li><li>{{ section.settings.t_12 | escape }}</li></ul>
<p class="ag-note"><span class="vg">{{ section.settings.t_13 | escape }}</span><span class="fn">{{ section.settings.t_14 | escape }}</span></p>
<div class="price"><b>{{ section.settings.t_15 | escape }}</b><small>{{ section.settings.t_16 | escape }}</small><span class="vol" id="szVol">{{ section.settings.t_17 | escape }}</span></div>
<p class="soldnote">{{ section.settings.t_18 | escape | newline_to_br | strip_newlines }}</p>
<div aria-label="オプション" class="opt-box" role="group">
<label class="opt"><input checked="" data-price="1320" id="optOil" type="checkbox"/><img alt="" class="ti" decoding="async" loading="lazy" src="{% if section.settings.img_3 %}{{ section.settings.img_3 | image_url: width: 1800 }}{% else %}{{ 'img-b3ab3b980636.webp' | asset_url }}{% endif %}"/><span><b>{{ section.settings.t_19 }}</b><small>{{ section.settings.t_20 | escape | newline_to_br | strip_newlines }}</small></span><span class="p">{{ section.settings.t_21 | escape }}</span></label>
<label class="opt"><input data-price="330" id="optGift" type="checkbox"/><img alt="" class="ti" decoding="async" loading="lazy" src="{% if section.settings.img_4 %}{{ section.settings.img_4 | image_url: width: 1800 }}{% else %}{{ 'img-3bdc8772dbe5.webp' | asset_url }}{% endif %}"/><span><b>{{ section.settings.t_22 | escape }}</b><small>{{ section.settings.t_23 | escape }}</small></span><span class="p">{{ section.settings.t_24 | escape }}</span></label>
</div>
<div class="qtyrow">
<div class="qty"><button aria-label="減らす" id="qMinus" type="button">{{ section.settings.t_25 | escape }}</button><output id="qty">{{ section.settings.t_26 | escape }}</output><button aria-label="増やす" id="qPlus" type="button">{{ section.settings.t_27 | escape }}</button></div>
<div class="total"><span>{{ section.settings.t_28 | escape }}</span><b id="total">{{ section.settings.t_29 | escape }}</b></div>
</div>
<button class="addcart big" disabled="" id="buyBtn">{{ section.settings.t_30 | escape }}</button>
<p class="ship"><span id="shipTx">{{ section.settings.t_31 | escape }}</span><span class="bar"><i id="shipBar" style="width:84%"></i></span></p>
<div class="ingC"><h3>{{ section.settings.t_32 }}</h3><p class="ic-lead">{{ section.settings.t_33 | escape }}</p><p class="ic-sec">{{ section.settings.t_34 | escape }}</p><div class="ic-g"><h4>{{ section.settings.t_35 }}</h4><ul class="tiles five"><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_5 %}{{ section.settings.img_5 | image_url: width: 1800 }}{% else %}{{ 'img-33690fb24b1f.webp' | asset_url }}{% endif %}"/><span>{{ section.settings.t_36 | escape }}</span></li><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_6 %}{{ section.settings.img_6 | image_url: width: 1800 }}{% else %}{{ 'img-0996f123f7de.webp' | asset_url }}{% endif %}"/><span>{{ section.settings.t_37 | escape }}</span></li><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_7 %}{{ section.settings.img_7 | image_url: width: 1800 }}{% else %}{{ 'img-5d890b902915.webp' | asset_url }}{% endif %}"/><span>{{ section.settings.t_38 | escape }}</span></li></ul></div><div class="ic-g"><details class="ic-more"><summary>{{ section.settings.t_39 | escape }}</summary><p class="ic-sec ic-sec2">{{ section.settings.t_40 }}</p><div class="ic-g"><h4>{{ section.settings.t_41 }}</h4><ul class="tiles"><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_8 %}{{ section.settings.img_8 | image_url: width: 1800 }}{% else %}{{ 'img-c1575d06b548.webp' | asset_url }}{% endif %}"/><span>{{ section.settings.t_42 | escape }}</span></li><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_9 %}{{ section.settings.img_9 | image_url: width: 1800 }}{% else %}{{ 'img-4b8e54f71bb7.webp' | asset_url }}{% endif %}"/><span>{{ section.settings.t_43 | escape }}</span></li><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_10 %}{{ section.settings.img_10 | image_url: width: 1800 }}{% else %}{{ 'img-4d4aab12a91b.webp' | asset_url }}{% endif %}"/><span>{{ section.settings.t_44