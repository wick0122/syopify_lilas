/* セクション送り(パソコン):Enter・スペース・PageDownで次へ、Shift+Enter・Shift+スペース・PageUpで前へ */
(()=>{const STOPS=["#buy", "#voices", "#detail", "#why", "section.np-add", "#oil-check", "#howto", "#yourway", "section.with", "footer"],HIDE="#buy";
const hd=document.querySelector('header.site');const hh=()=>hd?Math.round(hd.getBoundingClientRect().height):0;
const setH=()=>document.documentElement.style.setProperty('--hh',(hh()||64)+'px');setH();addEventListener('resize',setH);
const mq=matchMedia('(min-width:901px)');
const tops=()=>STOPS.map(s=>document.querySelector(s)).filter(Boolean).map(x=>Math.round(x.getBoundingClientRect().top+scrollY)).sort((a,b)=>a-b);
function go(d){const vis=hd?Math.max(0,Math.round(hd.getBoundingClientRect().bottom)):0;const cur=Math.round(scrollY)+vis;const ts=tops();let t;const he=HIDE&&document.querySelector(HIDE);const hideY=he?Math.round(he.getBoundingClientRect().bottom+scrollY):Infinity;const off=v=>(d>0&&v>=hideY)?0:hh();const page=innerHeight-hh();
 if(d>0){t=ts.find(v=>v>cur+6);if(t===undefined)t=document.documentElement.scrollHeight;if(t-cur>page+40)t=cur+page-40;}
 else{t=[...ts].reverse().find(v=>v<cur-6);if(t===undefined)t=0;if(cur-t>page+40)t=cur-page+40;}
 scrollTo({top:Math.max(0,t-off(t)),behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth'})}
addEventListener('keydown',e=>{if(!mq.matches||e.metaKey||e.ctrlKey||e.altKey||e.isComposing)return;const tg=e.target;
 if(/^(INPUT|TEXTAREA|SELECT)$/.test(tg.tagName||'')||tg.isContentEditable)return;
 if(document.querySelector('dialog[open]')||document.body.classList.contains('notes'))return;
 const onCtl=tg.closest&&tg.closest('a,button,summary,label,[role=button],[role=radio],video');
 let d=0;
 if((e.key==='Enter'||e.key===' ')&&!onCtl)d=e.shiftKey?-1:1;
 else if(e.key==='PageDown')d=1;else if(e.key==='PageUp')d=-1;
 if(d){e.preventDefault();go(d)}});
/* ページ内リンクを押した後も、Enterで続けて送れるようにする */
document.addEventListener('click',e=>{const a=e.target.closest&&e.target.closest('a[href^="#"],summary');if(a)setTimeout(()=>a.blur(),0)})})();
</script>
<script>
document.querySelectorAll(".with .wi .size button").forEach(b=>b.addEventListener("click",()=>{const v=b.closest("article").querySelector(".wvol");if(v&&b.dataset.s)v.textContent=b.dataset.s}));
