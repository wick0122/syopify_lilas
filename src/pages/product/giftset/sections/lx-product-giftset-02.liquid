{%- liquid
  assign p = section.settings.product
  assign po = section.settings.oil_product
  assign pg = section.settings.gift_product
-%}
{%- if p -%}
<script>
window.LX_PRICE={{ p.selected_or_first_available_variant.price | divided_by: 100 }};
window.LX_CART={
  variants:[{%- for v in p.variants -%}{"id":{{ v.id }},"title":{{ v.title | json }},"available":{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  oil:{% if po %}{{ po.selected_or_first_available_variant.id }}{% else %}null{% endif %},
  gift:{% if pg %}{{ pg.selected_or_first_available_variant.id }}{% else %}null{% endif %}
};
</script>
{%- endif -%}
<section class="wrap buy lx-top lx-n1" id="buy">
<div class="gal">
<div aria-label="製品写真" class="thumbs" role="tablist"><button aria-label="写真1" class="on" data-src="{{ 'img-b585fa83f1e6.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_1 %}{{ section.settings.img_1 | image_url: width: 1800 }}{% else %}{{ 'img-d15d8f32cc05.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真2" data-src="{{ 'img-650781382b65.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_2 %}{{ section.settings.img_2 | image_url: width: 1800 }}{% else %}{{ 'img-31c1e57bdadc.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真3" data-src="{{ 'img-14b47b6433bd.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_3 %}{{ section.settings.img_3 | image_url: width: 1800 }}{% else %}{{ 'img-65f0d52a2ced.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真4" data-src="{{ 'img-b9d978e8fe55.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_4 %}{{ section.settings.img_4 | image_url: width: 1800 }}{% else %}{{ 'img-784652efdf82.webp' | asset_url }}{% endif %}"/></button><button aria-label="写真5" data-src="{{ 'img-0e10c2fd842b.webp' | asset_url }}"><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_5 %}{{ section.settings.img_5 | image_url: width: 1800 }}{% else %}{{ 'img-5cdf99d8b674.webp' | asset_url }}{% endif %}"/></button></div>
<figure class="ph main-ph"><img alt="ギフトセット スタートキット" decoding="async" id="mainImg" loading="lazy" src="{% if section.settings.img_6 %}{{ section.settings.img_6 | image_url: width: 1800 }}{% else %}{{ 'img-b585fa83f1e6.webp' | asset_url }}{% endif %}"/><span class="stamps"><span class="vg-badge"><svg aria-hidden="true" viewbox="0 0 16 16"><path d="M3 13C3 6 8 3 14 3C14 9 10 13 3 13Z M3 13L9 7" fill="none" stroke="currentColor" stroke-width="1"></path></svg>{{ section.settings.t_1 | escape }}</span></span></figure>
</div>
<div class="info">
<span class="nmb">{{ section.settings.t_2 | escape }}</span>
<h1>{{ section.settings.t_3 }}</h1>
<p class="jp">{{ section.settings.t_4 | escape }}</p><p class="subt">{{ section.settings.t_5 | escape }}</p>
<p class="catch">{{ section.settings.t_6 | escape | newline_to_br | strip_newlines }}</p>
<ul class="chips"><li>{{ section.settings.t_7 | escape }}</li><li>{{ section.settings.t_8 | escape }}</li><li>{{ section.settings.t_9 }}</li><li>{{ section.settings.t_10 | escape }}</li></ul>
<p class="ag-note">{{ section.settings.t_11 | escape }}</p>
<div class="price">{{ section.settings.t_12 }}</div><p class="gs-note">{{ section.settings.t_13 | escape }}</p>
<div class="qtyrow">
<div class="qty"><button aria-label="減らす" id="qMinus" type="button">{{ section.settings.t_14 | escape }}</button><output id="qty">{{ section.settings.t_15 | escape }}</output><button aria-label="増やす" id="qPlus" type="button">{{ section.settings.t_16 | escape }}</button></div>
<div class="total">{{ section.settings.t_17 }}</div>
</div>
<button class="addcart big" id="buyBtn">{{ section.settings.t_18 | escape }}</button>
<p class="ship">{{ section.settings.t_19 }}</p>
<div class="ingC"><h3>{{ section.settings.t_20 }}</h3><ul class="gs-list"><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_7 %}{{ section.settings.img_7 | image_url: width: 1800 }}{% else %}{{ 'img-cd5e51a627a0.webp' | asset_url }}{% endif %}"/><div><p class="gs-en">{{ section.settings.t_21 | escape }}</p><p class="gs-nm">{{ section.settings.t_22 }}</p><p class="gs-cat">{{ section.settings.t_23 | escape }}</p></div><span class="gs-vol">{{ section.settings.t_24 | escape }}</span></li><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_8 %}{{ section.settings.img_8 | image_url: width: 1800 }}{% else %}{{ 'img-6e3405db1a39.webp' | asset_url }}{% endif %}"/><div><p class="gs-en">{{ section.settings.t_25 | escape }}</p><p class="gs-nm">{{ section.settings.t_26 }}</p><p class="gs-cat">{{ section.settings.t_27 | escape }}</p></div><span class="gs-vol">{{ section.settings.t_28 | escape }}</span></li><li><img alt="" decoding="async" loading="lazy" src="{% if section.settings.img_9 %}{{ section.settings.img_9 | image_url: width: 1800 }}{% else %}{{ 'img-22141ba3ca5d.webp' | asset_url }}{% endif %}"/><div><p class="gs-en">{{ section.settings.t_29 | escape }}</p><p class="gs-nm">{{ section.settings.t_30 }}</p><p class="gs-cat">{{ section.settings.t_31 | escape }}</p></div><span class="gs-vol">{{ section.settings.t_32 | escape }}</span></li></ul></div>
<ul class="mini"><li>{{ section.settings.t_33 }}</li><li>{{ section.settings.t_34 }}</li></ul>
</div>
</section>
