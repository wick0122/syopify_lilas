<button aria-expanded="false" class="notes-tab" id="openNotes">News<span class="nt-ja">お知らせ</span></button>
<div class="scrim" id="scrim"></div>
<aside aria-label="News" class="drawer" id="drawer">
<button class="close" id="closeNotes">閉じる</button>
<h2 class="nw-h">News<span>お知らせ</span></h2>
<!-- お知らせ:内容は news.js で管理しています(この下はnews.jsを読み込めないときの予備) -->
<ul class="nw-list">
<li><details><summary><time datetime="2026-12">2026.12</time><span class="nw-t">年末年始の配送休業のお知らせ</span></summary><div class="nw-bd">休業期間は、決まり次第こちらでお知らせします。</div></details></li>
<li><details><summary><time datetime="2026-11-05">2026.11.05</time><span class="nw-t">待望の新作が誕生。</span></summary><div class="nw-bd">肌荒れを防ぎ、キメを整える新作「カームスムース」が誕生しました。<a class="nw-lk" href="/pages/lilas-product-calmsmooth">カームスムースを見る →</a></div></details></li>
</ul>
</aside>
<script>
/* お知らせ:news.js の内容でパネルを作り直す(読み込めないときは、ページに書いてある内容をそのまま表示) */
(()=>{const L=window.LILAS_NEWS,ul=document.querySelector(".nw-list");if(!L||!ul)return;
 const esc=s=>String(s);ul.innerHTML=L.map(n=>{const t=`<time datetime="${n.date}">${n.label}</time>`;let b=n.body||"";if(n.link)b+=`<a class="nw-lk" href="${n.link}">${n.linkText||"詳しく見る"} →</a>`;
  return b?`<li><details><summary>${t}<span class="nw-t">${esc(n.title)}</span></summary><div class="nw-bd">${b}</div></details></li>`:`<li><div class="nw-row">${t}<span class="nw-t">${esc(n.title)}</span></div></li>`}).join("");
 const f=ul.querySelector("details");if(f)f.open=true})();
</script>
<script>
document.documentElement.classList.add("js");
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("shown");io.unobserve(e.target)}}),{rootMargin:"0px 0px -10% 0px"});
document.querySelectorAll("[data-r]").forEach(el=>io.observe(el));
const openN=document.getElementById("openNotes");const setN=on=>{document.body.classList.toggle("notes",on);openN.setAttribute("aria-expanded",on)};
openN.onclick=()=>setN(true);document.getElementById("closeNotes").onclick=()=>setN(false);document.getElementById("scrim").onclick=()=>setN(false);
document.addEventListener("keydown",e=>{if(e.key==="Escape")setN(false)});
</script>
<script>(function(){var v=document.querySelector("video.bg");if(!v)return;var ss=[].slice.call(v.querySelectorAll("source[data-src]"));var c=ss.map(function(s){return {u:s.getAttribute("data-src"),t:s.type,q:s.type=="video/mp4"?'video/mp4; codecs="avc1.640028"':'video/webm; codecs="vp9"'}}).filter(function(x){return v.canPlayType(x.q)});ss.forEach(function(s){s.remove()});v.muted=true;v.setAttribute("muted","");function go(i){if(i>=c.length)return;v.onerror=function(){go(i+1)};v.preload="auto";v.src=c[i].u;v.load();var p=v.play();if(p&&p.catch)p.catch(function(){})}go(0)})();</script>
<script>
// 動画:読み込み後すぐ再生。Safariでも動くようBlobに変換し、だめなら元のデータで再生
(()=>{document.querySelectorAll("video.blobv").forEach(v=>{
  v.muted=true;v.defaultMuted=true;v.setAttribute("muted","");v.setAttribute("autoplay","");v.setAttribute("playsinline","");v.preload="none";
  const ss=[...v.querySelectorAll("source[data-src]")].map(s=>({u:s.dataset.src,t:s.type,q:s.type=="video/mp4"?'video/mp4; codecs="avc1.640028"':'video/webm; codecs="vp9"'})).filter(x=>v.canPlayType(x.q)||v.canPlayType(x.t));
  const play=()=>{const p=v.play();if(p&&p.catch)p.catch(()=>{})};
  const go=i=>{if(i>=ss.length)return;v.onerror=()=>go(i+1);
    (v.src=ss[i].u,v.load(),play())};
  {const lz=new IntersectionObserver(es=>{if(es.some(e=>e.isIntersecting)){lz.disconnect();go(0)}},{rootMargin:"400px 0px"});lz.observe(v)}
  v.addEventListener("canplay",play);
  new IntersectionObserver(es=>es.forEach(e=>{e.isIntersecting?play():v.pause()}),{threshold:.1}).observe(v)})})();
// 画面のどこかを触ったら再生を再試行(省電力モードなどで止められた場合の保険)
addEventListener("touchstart",()=>document.querySelectorAll("video.blobv").forEach(v=>{if(v.paused){const p=v.play();if(p&&p.catch)p.catch(()=>{})}}),{once:true,passive:true});
</script>
<script>(()=>{const h=document.querySelector("header.site"),b=h&&h.querySelector(".mbtn");if(!b)return;b.addEventListener("click",()=>h.classList.toggle("menu"));h.querySelectorAll("nav a").forEach(a=>a.addEventListener("click",()=>h.classList.remove("menu")))})();</script>
<script>
/* セクション送り:Enter・スペース・PageDownで次のセクションへ、Shift+Enter・Shift+スペース・PageUpで前へ(パソコン) */
(()=>{const hd=document.querySelector('header.site');const setH=()=>document.documentElement.style.setProperty('--hh',(hd?Math.round(hd.getBoundingClientRect().height):64)+'px');setH();addEventListener('resize',setH);
const mq=matchMedia('(min-width:901px)');
const secs=()=>[...document.querySelectorAll('.fhero,#f1,#f2,#f3,#f4,#f4b,#f4c,#f4d,#f4e,#f5,#f6,#f7,footer')];
function go(d){const H=hd?hd.getBoundingClientRect().height:0;const cur=scrollY+H;const tops=secs().map(x=>Math.round(x.getBoundingClientRect().top+scrollY));
let t=d>0?tops.find(v=>v>cur+6):[...tops].reverse().find(v=>v<cur-6);
if(t===undefined)t=d>0?document.documentElement.scrollHeight:0;
scrollTo({top:Math.max(0,t-H),behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth'})}
addEventListener('keydown',e=>{if(!mq.matches||e.metaKey||e.ctrlKey||e.altKey||e.isComposing)return;const tg=e.target;
if(/^(INPUT|TEXTAREA|SELECT)$/.test(tg.tagName||'')||tg.isContentEditable)return;
if(document.querySelector('dialog[open]')||document.body.classList.contains('notes'))return;
const onCtl=tg.closest&&tg.closest('a,button,summary,[role=button],video');
let d=0;
if(e.key==='Enter'&&!onCtl)d=e.shiftKey?-1:1;
else if(e.key===' '&&!onCtl)d=e.shiftKey?-1:1;
else if(e.key==='PageDown')d=1;else if(e.key==='PageUp')d=-1;
if(d){e.preventDefault();go(d)}});
/* 目次などページ内リンクを押した後も、Enterで続けて送れるようにする */
document.addEventListener('click',e=>{const a=e.target.closest&&e.target.closest('a[href^="#"]');if(a)setTimeout(()=>a.blur(),0)})})();
</script>
