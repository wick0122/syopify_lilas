<script>
/* セクション送り:Enter・スペース・PageDownで次のセクションへ、Shift+Enter・Shift+スペース・PageUpで前へ(パソコン) */
(()=>{const hd=document.querySelector('header.site');const setH=()=>document.documentElement.style.setProperty('--hh',(hd?Math.round(hd.getBoundingClientRect().height):64)+'px');setH();addEventListener('resize',setH);
const mq=matchMedia('(min-width:901px)');
const secs=()=>[...document.querySelectorAll('.fhero,#f1,#f2,#f3,#f4,#f4b,#f4c,#f4d,#f4e,#f5,#f6,#f7,footer')];
function go(d){const H=hd?hd.getBoundingClientRect().height:0;const cur=scrollY+H;const tops=secs().map(x=>Math.round(x.getBoundingClientRect().top+scrollY));
let t=d>0?tops.find(v=>v>cur+6):[...tops].reverse().find(v=>v<cur-6);
if(t===undefined)t=d>0?document.documentElement.scrollHeight:0;
scrollTo({top:Math.max(0,t-H),behavior:matchMedia('(prefers-reduced-motion:reduce)').matches?'auto':'smooth'})}
addEventListener('keydown',e=>{if(!mq.matches||e.metaKey||e.ctrlKey||e.altKey||e.isComposing)return;const tg=e.target;
if(/^(INPUT|TEXTAREA|SELECT)$/.test(tg.tagName||'')||tg.isContentEditable)return;
if(document.querySelector('dialog[open]')||document.body.classList.contains('notes'))return;
const onCtl=tg.closest&&tg.closest('a,button,summary,[role=button],video');
let d=0;
if(e.key==='Enter'&&!onCtl)d=e.shiftKey?-1:1;
else if(e.key===' '&&!onCtl)d=e.shiftKey?-1:1;
else if(e.key==='PageDown')d=1;else if(e.key==='PageUp')d=-1;
if(d){e.preventDefault();go(d)}});
/* 目次などページ内リンクを押した後も、Enterで続けて送れるようにする */
document.addEventListener('click',e=>{const a=e.target.closest&&e.target.closest('a[href^="#"]');if(a)setTimeout(()=>a.blur(),0)})})();
</script>
