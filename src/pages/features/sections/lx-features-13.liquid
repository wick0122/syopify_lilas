<section class="fsec yw3 lx-top lx-n11" id="f6"><div class="wrap center">
<div data-r=""><p class="disp">{{ section.settings.t_1 }}</p><h2 class="sh2">{{ section.settings.t_2 | escape }}</h2></div>
<figure class="ph yw3-ph" data-r=""><img alt="腕にローションをなじませる女性" decoding="async" loading="lazy" src="{% if section.settings.img_1 %}{{ section.settings.img_1 | image_url: width: 1800 }}{% else %}{{ 'img-9e769f416d5f.webp' | asset_url }}{% endif %}"/></figure>
<p class="ftx yw3-tx" data-r="">{{ section.settings.t_3 | escape | newline_to_br | strip_newlines }}</p>
<div data-r=""><a class="addcart big" href="/pages/lilas-products">{{ section.settings.t_4 | escape }}</a></div>
</div></section>
{% schema %}
{
  "name": "特徴 13 06 使い方",
  "tag": "div",
  "class": "lx-sec",
  "settings": [
    {
      "type": "image_picker",
      "id": "img_1",
      "label": "画像：腕にローションをなじませる女性",
      "info": "未設定のときは元の画像（img-9e769f416d5f.webp）を表示します"
    },
    {
      "type": "html",
      "id": "t_1",
      "label": "Your way",
      "info": "文字の装飾タグ（<br> や <span> など）を含みます。文字だけ書き換えてください"
    },
    {
      "type": "text",
      "id": "t_2",
      "label": "肌に合わせて、使い方も自由に。"
    },
    {
      "type": "textarea",
      "id": "t_3",
      "label": "1本でも、オールインワンとして使えるLila…",
      "info": "改行はそのまま反映されます"
    },
    {
      "type": "text",
      "id": "t_4",
      "label": "製品を見る"
    }
  ]
}
{% endschema %}
